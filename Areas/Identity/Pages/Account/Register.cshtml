@page
@model RegisterModel
@{
    Layout = null; // Default layout removed
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>

    <!-- CSS Links -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background-color: #ffffff;">

    <!-- HEADER: Home nav link removed -->
    <header class="ht-navbar">
        <!-- Logo links to Home page -->
        <a href="/" class="ht-logo">
            <div class="logo-heart">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <span>HealthTrack</span>
        </a>

        <!-- Buttons pushed to the right using margin-left: auto -->
        <div class="nav-buttons" style="margin-left: auto;">
            <a href="/Identity/Account/Login" class="login-btn">Login</a>
            <a href="/Identity/Account/Register" class="register-btn" style="background-color: #008f78; border-color: #008f78;">Register</a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container-fluid p-0">
        <div class="row g-0" style="min-height: calc(100vh - 82px);">

            <!-- Left Side: Register Form -->
            <div class="col-lg-5 col-md-6 d-flex align-items-center justify-content-center bg-white">
                <div class="register-form-container w-100" style="max-width: 400px; padding: 20px;">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold fs-3 text-dark mb-1">Create Account</h2>
                        <p class="text-muted small">Join HealthTrack and start your journey</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="Input.FullName" class="form-control bg-light border-start-0 ps-0" autocomplete="name" aria-required="true" placeholder="Full Name" />
                            <span asp-validation-for="Input.FullName" class="text-danger small w-100 mt-1"></span>
                        </div>

                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.Email" class="form-control bg-light border-start-0 ps-0" autocomplete="username" aria-required="true" placeholder="Email address" />
                            <span asp-validation-for="Input.Email" class="text-danger small w-100 mt-1"></span>
                        </div>

                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" id="passwordInput" class="form-control bg-light border-start-0 border-end-0 ps-0" autocomplete="new-password" aria-required="true" placeholder="Password" />
                            <span class="input-group-text bg-light border-start-0 text-muted" style="cursor: pointer;" onclick="togglePassword()">
                                <i class="bi bi-eye-slash" id="toggleIcon"></i>
                            </span>
                            <span asp-validation-for="Input.Password" class="text-danger small w-100 mt-1"></span>
                        </div>

                        <input type="hidden" asp-for="Input.ConfirmPassword" id="confirmPasswordInput" />

                        <div class="mb-4">
                            <label class="form-label text-muted small mb-1">Select Role</label>
                            <select asp-for="Input.Role" asp-items="@Model.RoleList" class="form-select bg-light border" style="border-radius: 8px;">
                                <option value="">-- Select Role --</option>
                            </select>
                            <span asp-validation-for="Input.Role" class="text-danger small"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn text-white fw-bold py-2 mb-4" style="background-color: #008f78; border-radius: 8px;">
                            Register
                        </button>

                        <div class="text-center small text-muted">
                            Already have an account?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none" style="color: #008f78;">Login</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Side: Image -->
            <div class="col-lg-7 col-md-6 d-none d-md-block position-relative p-0">
                <div class="position-absolute w-100 h-100" style="top: 0; left: 0; background-image: url('https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center;">
                    <div class="h-100 w-100 d-flex align-items-end" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 50%);">
                        <div class="text-white p-5 mb-5">
                            <h1 class="fw-bold display-5 mb-3">Track.<br>Plan.<br>Achieve.</h1>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- Footer Include -->
    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePassword() {
        var passwordInput = document.getElementById("passwordInput");
        var toggleIcon = document.getElementById("toggleIcon");
        if (passwordInput.type === "password") {
        passwordInput.type = "text";
        toggleIcon.classList.remove("bi-eye-slash");
        toggleIcon.classList.add("bi-eye");
        } else {
        passwordInput.type = "password";
        toggleIcon.classList.remove("bi-eye");
        toggleIcon.classList.add("bi-eye-slash");
        }
        }

        document.getElementById('passwordInput').addEventListener('input', function() {
        document.getElementById('confirmPasswordInput').value = this.value;
        });
    </script>
</body>
</html>