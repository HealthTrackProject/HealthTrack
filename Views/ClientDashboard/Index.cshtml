@model HealthTrack.Models.ClientDashboardViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Client Dashboard";
    ViewData["Heading"] = "Welcome, Client";
    ViewData["ActivePage"] = "Dashboard";
}

<!-- WELCOME SECTION -->
<section class="welcome-section">
    <div>
        <h2>Your Health Overview</h2>
        <p>Keep moving forward. Every healthy choice matters.</p>
    </div>

    <div class="today-label">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dd MMM yyyy")
    </div>
</section>

<!-- HEALTH STATISTICS -->
<section class="stats-grid">

    <article class="stat-card blue">
        <div class="stat-icon"><i class="bi bi-person-standing"></i></div>
        <h3>@Model.CurrentWeight.ToString("0.0") kg</h3>
        <p>Current Weight</p>
    </article>

    <article class="stat-card green">
        <div class="stat-icon"><i class="bi bi-clipboard2-check"></i></div>
        <h3>@Model.CurrentBMI.ToString("0.0")</h3>
        <p>Body Mass Index (BMI)</p>
    </article>

    <article class="stat-card orange">
        <div class="stat-icon"><i class="bi bi-activity"></i></div>
        <h3>@Model.WeeklyCalories</h3>
        <p>Calories / Week</p>
    </article>

    <article class="stat-card purple">
        <div class="stat-icon"><i class="bi bi-hand-thumbs-up"></i></div>
        <h3>@Model.WeeklyWorkouts</h3>
        <p>Workouts / Week</p>
    </article>

</section>

<!-- UPCOMING ACTIVITIES AND CHARTS -->
<section class="dashboard-grid">

    <!-- UPCOMING ACTIVITIES -->
    <article class="content-card activities-card">
        <div class="card-header">
            <h3>Upcoming Activities</h3>
            <i class="bi bi-three-dots"></i>
        </div>

        <div class="activity-list">
            @if (Model.UpcomingActivities.Any())
            {
                @foreach (var activity in Model.UpcomingActivities)
                {
                    <div class="activity-item">
                        <div class="activity-icon @activity.Color">
                            <i class="bi @activity.Icon"></i>
                        </div>
                        <div>
                            <h4>@activity.Title</h4>
                            <p>@activity.Time</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color: var(--muted); font-size: 13px;">No upcoming activities.</p>
            }
        </div>
    </article>

    <!-- WEEKLY CALORIES BURNED -->
    <article class="content-card calories-card">
        <div class="card-header">
            <div>
                <h3>Weekly Calories Burned</h3>
                <p class="graph-subtitle">Your estimated daily activity</p>
            </div>
            <span class="graph-badge">
                <i class="bi bi-fire"></i> This Week
            </span>
        </div>

        <div class="calories-summary">
            <div>
                <span>Total This Week</span>
                <h2 id="weeklyCalories">0 <small>kcal</small></h2>
            </div>
            <div class="calories-summary-icon">
                <i class="bi bi-lightning-charge"></i>
            </div>
        </div>

        <div class="calories-chart-container">
            <svg class="calories-chart" viewBox="0 0 700 240" preserveAspectRatio="none" role="img" aria-label="Calories burned from Monday to Sunday">
                <defs>
                    <linearGradient id="caloriesFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#1687f8" stop-opacity="0.20" />
                        <stop offset="100%" stop-color="#1687f8" stop-opacity="0.01" />
                    </linearGradient>
                </defs>

                <!-- Grid lines -->
                <line class="calories-grid-line" x1="45" y1="30" x2="680" y2="30" />
                <line class="calories-grid-line" x1="45" y1="75" x2="680" y2="75" />
                <line class="calories-grid-line" x1="45" y1="120" x2="680" y2="120" />
                <line class="calories-grid-line" x1="45" y1="165" x2="680" y2="165" />
                <line class="calories-grid-line" x1="45" y1="210" x2="680" y2="210" />

                <!-- Y-Axis Labels -->
                <text class="calories-axis-label" x="2" y="34">600</text>
                <text class="calories-axis-label" x="2" y="79">450</text>
                <text class="calories-axis-label" x="2" y="124">300</text>
                <text class="calories-axis-label" x="2" y="169">150</text>
                <text class="calories-axis-label" x="12" y="214">0</text>

                <!-- Chart Elements (Values will be updated via JS) -->
                <path id="caloriesArea" d="" fill="url(#caloriesFill)" />
                <polyline id="caloriesLine" class="calories-line" points="" />
                <g id="caloriesPoints" fill="#1687f8"></g>
            </svg>
        </div>

        <div class="calories-day-labels">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>

        <div class="calories-legend">
            <span class="legend-dot"></span>
            Estimated calories burned per day
        </div>
    </article>

    <!-- WEIGHT PROGRESS -->
    <article class="content-card weight-progress-card">
        <div class="card-header">
            <h3>Weight Progress</h3>
            <select class="card-select" id="weightPeriod" aria-label="Select progress period">
                <option value="6">Last 6 Months</option>
                <option value="3">Last 3 Months</option>
                <option value="12">Last 12 Months</option>
            </select>
        </div>

        <div class="chart-container">
            <svg class="weight-chart" viewBox="0 0 340 230" preserveAspectRatio="none" role="img" aria-label="Weight progress chart">
                <defs>
                    <linearGradient id="weightFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#20bd79" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#20bd79" stop-opacity="0.01" />
                    </linearGradient>
                </defs>

                <!-- Grid Lines -->
                <line class="chart-grid-line" x1="38" y1="20" x2="330" y2="20" />
                <line class="chart-grid-line" x1="38" y1="75" x2="330" y2="75" />
                <line class="chart-grid-line" x1="38" y1="130" x2="330" y2="130" />
                <line class="chart-grid-line" x1="38" y1="185" x2="330" y2="185" />

                <!-- Y-Axis Labels (Static for now) -->
                <text class="chart-label" x="4" y="24">80</text>
                <text class="chart-label" x="4" y="79">75</text>
                <text class="chart-label" x="4" y="134">70</text>
                <text class="chart-label" x="4" y="189">65</text>

                <!-- Chart Elements (Values will be updated via JS) -->
                <path id="weightArea" d="" fill="url(#weightFill)" />
                <polyline id="weightLine" class="chart-line" points="" />
                <circle id="weightPoint" cx="0" cy="0" r="4" fill="#20bd79" />
            </svg>
        </div>

        <div class="chart-months" id="chartMonths">
            <!-- Populated by JS -->
        </div>

        <div class="chart-data-list" id="chartDataList">
            <!-- Populated by JS -->
        </div>
    </article>

    <!-- DAILY HEALTH TIPS -->
    <article class="content-card health-tips-card">
        <div class="card-header">
            <h3><i class="bi bi-lightbulb"></i> Daily Health Tips</h3>
        </div>
        <div class="health-tip-item">
            <div class="tip-icon green"><i class="bi bi-droplet"></i></div>
            <div>
                <h4>Stay Hydrated</h4>
                <p>Drink water regularly throughout the day.</p>
            </div>
        </div>
        <div class="health-tip-item">
            <div class="tip-icon blue"><i class="bi bi-person-walking"></i></div>
            <div>
                <h4>Keep Moving</h4>
                <p>Include regular physical activity in your routine.</p>
            </div>
        </div>
        <div class="health-tip-item">
            <div class="tip-icon orange"><i class="bi bi-egg-fried"></i></div>
            <div>
                <h4>Eat Balanced Meals</h4>
                <p>Choose a variety of nutritious foods.</p>
            </div>
        </div>
    </article>

</section>

@section Scripts {
    <script>
        (() => {
            // 1. Get dynamic data from C# ViewModel and convert to JavaScript objects
            const dynamicWeightData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightChartData));
            const dynamicCalorieData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CaloriesChartData));

            // Map C# ChartDataPoint (Label, Value) to what the charts expect
            const monthlyWeights = dynamicWeightData.map(d => ({
                month: d.Label,
                short: d.Label,
                weight: d.Value
            }));

            const calorieData = dynamicCalorieData.map(d => ({
                day: d.Label,
                calories: d.Value
            }));

            // --- WEIGHT CHART LOGIC ---
            const periodSelect = document.getElementById("weightPeriod");
            const monthsContainer = document.getElementById("chartMonths");
            const dataContainer = document.getElementById("chartDataList");
            const weightLine = document.getElementById("weightLine");
            const weightArea = document.getElementById("weightArea");
            const weightPoint = document.getElementById("weightPoint");

            function renderWeightChart() {
                // If no data exists in DB, hide the chart elements
                if (!periodSelect || !monthsContainer || !dataContainer || !weightLine || !weightArea || !weightPoint) return;
                if (monthlyWeights.length === 0) {
                    dataContainer.innerHTML = '<p style="font-size:12px;color:var(--muted);">No weight records found.</p>';
                    return;
                }

                // For demo purposes, if we have less records than the selected period, just show what we have
                const selected = monthlyWeights.slice(-Number(periodSelect.value));
                const left = 38, right = 330, top = 20, bottom = 185;

                // Calculate min/max weight to scale the graph properly
                let minWeight = Math.min(...selected.map(d => d.weight)) - 2;
                let maxWeight = Math.max(...selected.map(d => d.weight)) + 2;
                let weightRange = maxWeight - minWeight;

                const points = selected.map((item, index) => {
                    const x = selected.length === 1 ? 184 : left + index * (right - left) / (selected.length - 1);
                    const y = bottom - ((item.weight - minWeight) / weightRange) * (bottom - top);
                    return { ...item, x, y };
                });

                const first = points[0];
                const last = points[points.length - 1];

                weightLine.setAttribute("points", points.map(p => `${p.x},${p.y}`).join(" "));
                weightArea.setAttribute("d", `M${first.x},${first.y} ` + points.slice(1).map(p => `L${p.x},${p.y}`).join(" ") + ` L${last.x},${bottom} L${first.x},${bottom} Z`);
                weightPoint.setAttribute("cx", last.x);
                weightPoint.setAttribute("cy", last.y);

                monthsContainer.innerHTML = points.map(p => `<span>${p.short}</span>`).join("");
                monthsContainer.style.gridTemplateColumns = `repeat(${points.length}, minmax(0, 1fr))`;

                dataContainer.innerHTML = points.map(p => `<div><span>${p.month}</span><strong>${p.weight} kg</strong></div>`).join("");
            }

            if (periodSelect) {
                periodSelect.addEventListener("change", renderWeightChart);
                renderWeightChart();
            }

            // --- CALORIES CHART LOGIC ---
            const calorieLine = document.getElementById("caloriesLine");
            const calorieArea = document.getElementById("caloriesArea");
            const caloriePoints = document.getElementById("caloriesPoints");
            const weeklyCalories = document.getElementById("weeklyCalories");

            if (calorieLine && calorieArea && caloriePoints && weeklyCalories) {
                if (calorieData.length === 0) {
                    // Show default flat line if no workouts this week
                    calorieLine.setAttribute("points", "45,210 680,210");
                } else {
                    const left = 45, right = 680, top = 30, bottom = 210;
                    // Find max calorie for scaling (min 600 to look good)
                    const maxCalories = Math.max(600, ...calorieData.map(d => d.calories));

                    const points = calorieData.map((item, index) => {
                        const x = left + index * (right - left) / (calorieData.length > 1 ? calorieData.length - 1 : 1);
                        const y = bottom - (item.calories / maxCalories) * (bottom - top);
                        return { ...item, x, y };
                    });

                    const first = points[0];
                    const last = points[points.length - 1];

                    calorieLine.setAttribute("points", points.map(p => `${p.x},${p.y}`).join(" "));

                    if (points.length > 1) {
                        calorieArea.setAttribute("d", `M${first.x},${first.y} ` + points.slice(1).map(p => `L${p.x},${p.y}`).join(" ") + ` L${last.x},${bottom} L${first.x},${bottom} Z`);
                    }

                    caloriePoints.innerHTML = points.map(p => `<circle cx="${p.x}" cy="${p.y}" r="5"></circle>`).join("");
                }

                // Calculate total calories (already calculated in Controller, but let's sum it here too for safety)
                const total = calorieData.reduce((sum, item) => sum + item.calories, 0);
                weeklyCalories.innerHTML = `${total.toLocaleString()} <small>kcal</small>`;
            }
        })();
    </script>
}