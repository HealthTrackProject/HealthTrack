@model HealthTrack.Models.WorkoutViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Workout";
    ViewData["Heading"] = "Welcome Back";
    ViewData["ActivePage"] = "Workout";
}

<section class="health-page workout-page">

    <div class="health-page-header">
        <div>
            <h2>My Workout Plan</h2>
            <p>Track your exercises and stay active.</p>
        </div>

        <button type="button" class="health-primary-button" id="logWorkoutBtn">
            <i class="bi bi-plus-lg"></i> Log Workout
        </button>
    </div>

    <div class="plan-tabs">
        <button type="button" class="tab-btn active" data-tab="current">Current Plan</button>
        <button type="button" class="tab-btn" data-tab="history">Workout History</button>
    </div>

    <!-- CURRENT PLAN (Mock Data from ViewModel) -->
    <div class="workout-list" id="currentPlanList">
        @foreach (var day in Model.CurrentPlan)
        {
            <article class="workout-item">
                <div class="workout-color-bar"></div>
                <div class="workout-content">
                    <div class="workout-day-info">
                        <h4>@day.Day</h4>
                        <p>@day.MuscleGroup</p>
                    </div>
                    <div class="workout-exercises">@day.Exercises</div>
                    <button type="button" class="btn-view"
                            data-view="true"
                            data-name="@day.Day Workout"
                            data-group="@day.MuscleGroup"
                            data-date="@day.Day"
                            data-exercises="@day.Exercises">
                        View
                    </button>
                </div>
            </article>
        }
    </div>

    <!-- WORKOUT HISTORY (Real Data from Database) -->
    <div class="workout-list" id="historyList" hidden>
        @if (Model.WorkoutHistory.Any())
        {
            @foreach (var workout in Model.WorkoutHistory)
            {
                <article class="workout-item workout-history-item">
                    <div class="workout-color-bar"></div>
                    <div class="workout-content">
                        <div class="workout-day-info">
                            <h4>@workout.WorkoutDate.ToString("dd MMM yyyy")</h4>
                            <p>Logged Session</p>
                        </div>
                        <div class="workout-exercises">@workout.ExerciseName</div>
                        <button type="button" class="btn-view"
                                data-view="true"
                                data-name="Workout Details"
                                data-group="Logged Session"
                                data-date="@workout.WorkoutDate.ToString("dd MMM yyyy")"
                                data-exercises="@workout.ExerciseName"
                                data-duration="@workout.DurationMinutes"
                                data-calories="@workout.CaloriesBurned">
                            View
                        </button>
                    </div>
                </article>
            }
        }
        else
        {
            <p class="workout-empty-state" id="workoutEmptyState">
                No workout history yet. Click <strong>Log Workout</strong> to record your first workout.
            </p>
        }
    </div>
</section>

<!-- WORKOUT MODAL -->
<div class="ca-modal" id="workoutModal" hidden>
    <div class="ca-modal-content workout-modal-content" role="dialog" aria-modal="true" aria-labelledby="workoutModalTitle">
        <button type="button" class="ca-modal-close" id="workoutModalClose" aria-label="Close popup">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="ca-modal-icon">
            <i class="bi bi-activity"></i>
        </div>

        <h3 id="workoutModalTitle">Log Workout</h3>
        <p class="workout-modal-subtitle" id="workoutModalSubtitle">Record your workout details below.</p>

        <!-- FORM: Now Submits to Controller -->
        <form id="workoutForm" asp-action="LogWorkout" asp-controller="ClientDashboard" method="post">
            @Html.AntiForgeryToken()

            <div class="workout-form-grid">
                <div class="workout-form-field">
                    <label for="workoutName">Workout name <span>*</span></label>
                    <input type="text" id="workoutName" name="workoutName" maxlength="100" placeholder="e.g. Morning workout" required />
                </div>

                <div class="workout-form-field">
                    <label for="workoutGroup">Muscle group <span>*</span></label>
                    <select id="workoutGroup" name="workoutGroup" required>
                        <option value="">Select muscle group</option>
                        <option value="Chest & Arms">Chest & Arms</option>
                        <option value="Legs">Legs</option>
                        <option value="Back & Shoulders">Back & Shoulders</option>
                        <option value="Cardio">Cardio</option>
                        <option value="Full Body">Full Body</option>
                        <option value="Core">Core</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="workout-form-field workout-field-full">
                    <label for="workoutExercises">Exercises <span>*</span></label>
                    <textarea id="workoutExercises" name="workoutExercises" rows="3" maxlength="1000" placeholder="e.g. Push-ups 3x15, Squats 3x12" required></textarea>
                </div>

                <div class="workout-form-field">
                    <label for="workoutDuration">Duration (minutes) <span>*</span></label>
                    <input type="number" id="workoutDuration" name="workoutDuration" min="1" max="1440" placeholder="30" required />
                </div>

                <div class="workout-form-field">
                    <label for="workoutCalories">Calories burned</label>
                    <input type="number" id="workoutCalories" name="workoutCalories" min="0" max="100000" placeholder="Optional" />
                </div>

                <div class="workout-form-field workout-field-full">
                    <label for="workoutDate">Workout date <span>*</span></label>
                    <input type="date" id="workoutDate" name="workoutDate" required />
                </div>
            </div>

            <div class="workout-modal-actions" id="workoutFormActions">
                <button type="button" class="workout-secondary-button" id="workoutCancelBtn">Cancel</button>
                <!-- Submit Button -->
                <button type="submit" class="health-primary-button">
                    <i class="bi bi-check-lg"></i> Save Workout
                </button>
            </div>
        </form>

        <!-- DETAILS VIEW -->
        <div id="workoutDetails" hidden>
            <div class="workout-details-list">
                <div><span>Workout name</span><strong id="detailName">—</strong></div>
                <div><span>Muscle group</span><strong id="detailGroup">—</strong></div>
                <div><span>Date</span><strong id="detailDate">—</strong></div>
                <div><span>Duration</span><strong id="detailDuration">—</strong></div>
                <div><span>Calories burned</span><strong id="detailCalories">—</strong></div>
                <div class="workout-detail-exercises"><span>Exercises</span><p id="detailExercises">—</p></div>
            </div>
            <div class="workout-modal-actions">
                <button type="button" class="health-primary-button" id="workoutDetailsCloseBtn">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workout.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById("workoutModal");
            const form = document.getElementById("workoutForm");
            const currentList = document.getElementById("currentPlanList");
            const historyList = document.getElementById("historyList");

            const title = document.getElementById("workoutModalTitle");
            const subtitle = document.getElementById("workoutModalSubtitle");
            const details = document.getElementById("workoutDetails");
            const formActions = document.getElementById("workoutFormActions");

            if (!modal || !form || !currentList || !historyList) return;

            function getLocalDate() {
                const now = new Date();
                const offset = now.getTimezoneOffset() * 60000;
                return new Date(now.getTime() - offset).toISOString().slice(0, 10);
            }

            function openModal() {
                modal.hidden = false;
                document.body.classList.add("modal-open");
            }

            function closeModal() {
                modal.hidden = true;
                document.body.classList.remove("modal-open");
            }

            function showLogForm() {
                form.reset();
                document.getElementById("workoutDate").value = getLocalDate();

                title.textContent = "Log Workout";
                subtitle.textContent = "Record your workout details below.";

                form.hidden = false;
                details.hidden = true;
                formActions.hidden = false;

                openModal();
                document.getElementById("workoutName").focus();
            }

            function showDetails(workout) {
                title.textContent = workout.name || "Workout Details";
                subtitle.textContent = "Here are the details for this workout.";

                document.getElementById("detailName").textContent = workout.name || "—";
                document.getElementById("detailGroup").textContent = workout.group || "—";
                document.getElementById("detailDate").textContent = workout.date || "—";
                document.getElementById("detailDuration").textContent = workout.duration ? workout.duration + " minutes" : "Not specified";
                document.getElementById("detailCalories").textContent = workout.calories ? workout.calories + " kcal" : "Not specified";
                document.getElementById("detailExercises").textContent = workout.exercises || "Not specified";

                form.hidden = true;
                details.hidden = false;
                formActions.hidden = true;

                openModal();
            }

            document.getElementById("logWorkoutBtn")?.addEventListener("click", showLogForm);
            document.getElementById("workoutModalClose")?.addEventListener("click", closeModal);
            document.getElementById("workoutCancelBtn")?.addEventListener("click", closeModal);
            document.getElementById("workoutDetailsCloseBtn")?.addEventListener("click", closeModal);

            modal.addEventListener("click", event => { if (event.target === modal) closeModal(); });
            document.addEventListener("keydown", event => { if (event.key === "Escape" && !modal.hidden) closeModal(); });

            // Tab Switching
            document.querySelectorAll(".tab-btn").forEach(button => {
                button.addEventListener("click", () => {
                    document.querySelectorAll(".tab-btn").forEach(tab => tab.classList.remove("active"));
                    button.classList.add("active");

                    const isHistory = button.dataset.tab === "history";
                    currentList.hidden = isHistory;
                    historyList.hidden = !isHistory;
                });
            });

            // View Button Clicks
            document.querySelectorAll("[data-view]").forEach(button => {
                button.addEventListener("click", () => {
                    showDetails({
                        name: button.dataset.name,
                        group: button.dataset.group,
                        date: button.dataset.date,
                        exercises: button.dataset.exercises,
                        duration: button.dataset.duration,
                        calories: button.dataset.calories
                    });
                });
            });

            // Removed the e.preventDefault() logic so the form submits naturally to the server
        })();
    </script>
}