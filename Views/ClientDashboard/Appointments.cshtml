@model HealthTrack.Models.ClientAppointmentsViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Appointments";
    ViewData["Heading"] = "My Appointments";
    ViewData["ActivePage"] = "Appointments";
}

<div class="client-appointments">

    <div class="client-appointments-header">
        <div>
            <h2>My Appointments</h2>
            <p>Manage your appointments and stay on top of your health.</p>
        </div>
        <button type="button" class="ca-request-btn" id="caRequestBtn">
            <i class="bi bi-plus-lg"></i> Request Appointment
        </button>
    </div>

    <div class="ca-card">
        <div class="ca-tabs">
            <button type="button" class="ca-tab active" data-tab="upcoming">Upcoming</button>
            <button type="button" class="ca-tab" data-tab="past">Past Appointments</button>
        </div>

        <div class="ca-table-wrapper">
            <table class="ca-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Trainer</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <!-- UPCOMING APPOINTMENTS -->
                <tbody id="caUpcoming">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            <tr>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@appt.AppointmentDate.ToString("hh:mm tt")</td>
                                <td>@(appt.Trainer?.FullName ?? "Any Available")</td>
                                <td>
                                    <span class="ca-status @appt.Status.ToLower()">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    @if (appt.Status == "Pending")
                                    {
                                        <!-- Cancel Form -->
                                        <form asp-action="CancelAppointment" asp-controller="ClientDashboard" asp-route-id="@appt.AppointmentId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ca-action cancel" onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="ca-action view"
                                                data-view="@appt.Trainer?.FullName | @appt.AppointmentDate.ToString("dd MMM yyyy") | @appt.AppointmentDate.ToString("hh:mm tt") | @appt.Status | @appt.Reason">
                                            View
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align:center;">No upcoming appointments.</td></tr>
                    }
                </tbody>

                <!-- PAST APPOINTMENTS -->
                <tbody id="caPast" hidden>
                    @if (Model.PastAppointments.Any())
                    {
                        @foreach (var appt in Model.PastAppointments)
                        {
                            <tr>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@appt.AppointmentDate.ToString("hh:mm tt")</td>
                                <td>@(appt.Trainer?.FullName ?? "Any Available")</td>
                                <td>
                                    <span class="ca-status @appt.Status.ToLower()">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="ca-action view"
                                            data-view="@appt.Trainer?.FullName | @appt.AppointmentDate.ToString("dd MMM yyyy") | @appt.AppointmentDate.ToString("hh:mm tt") | @appt.Status | @appt.Reason">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align:center;">No past appointments.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ca-footer">
            <span id="caSummary">Showing @Model.UpcomingAppointments.Count upcoming appointments</span>
            <span><i class="bi bi-heart-pulse"></i> HealthTrack</span>
        </div>
    </div>
</div>

<!-- REQUEST APPOINTMENT MODAL -->
<div class="ca-modal" id="caModal" hidden>
    <div class="ca-modal-content">
        <button type="button" class="ca-modal-close" id="caModalClose" aria-label="Close">&times;</button>

        <div class="ca-modal-icon">
            <i class="bi bi-calendar-check"></i>
        </div>

        <h3 id="caModalTitle">Request Appointment</h3>
        <p id="caModalText" class="text-muted small mb-3">Choose a preferred date and time for your appointment.</p>

        <!-- FORM: Submits to Controller -->
        <form asp-action="RequestAppointment" asp-controller="ClientDashboard" method="post" style="text-align: left;">
            @Html.AntiForgeryToken()

            <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                <div class="health-form-group" style="flex: 1;">
                    <label>Preferred Date</label>
                    <input type="date" name="appointmentDate" id="appointmentDate" required />
                </div>
                <div class="health-form-group" style="flex: 1;">
                    <label>Preferred Time</label>
                    <input type="time" name="appointmentTime" required />
                </div>
            </div>

            <div class="health-form-group" style="margin-bottom: 15px;">
                <label>Preferred Trainer</label>
                <select name="preferredTrainerId" class="form-control">
                    <option value="">Any available trainer</option>
                    @foreach (var trainer in Model.AvailableTrainers)
                    {
                        <option value="@trainer.Id">@trainer.FullName</option>
                    }
                </select>
            </div>

            <div class="health-form-group" style="margin-bottom: 20px;">
                <label>Reason for appointment</label>
                <textarea name="reason" rows="3" required placeholder="Briefly describe your request"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="health-secondary-button" id="cancelAppointmentForm">Cancel</button>
                <button type="submit" class="ca-request-btn">Submit Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const upcoming = document.getElementById("caUpcoming");
            const past = document.getElementById("caPast");
            const tabs = document.querySelectorAll(".ca-tab");
            const summary = document.getElementById("caSummary");
            const modal = document.getElementById("caModal");
            const modalTitle = document.getElementById("caModalTitle");
            const modalText = document.getElementById("caModalText");

            let activeTab = "upcoming";

            function showTab(tab) {
                activeTab = tab;
                tabs.forEach(button => {
                    button.classList.toggle("active", button.dataset.tab === tab);
                });

                upcoming.hidden = tab !== "upcoming";
                past.hidden = tab !== "past";

                if (tab === "upcoming") {
                    summary.textContent = `Showing ${upcoming.querySelectorAll("tr").length} upcoming appointments`;
                } else {
                    summary.textContent = `Showing ${past.querySelectorAll("tr").length} past appointments`;
                }
            }

            function openDetailsModal(text) {
                modalTitle.textContent = "Appointment Details";
                modalText.textContent = text;
                document.getElementById("appointmentFormHost").innerHTML = ""; // Clear form if any

                // Hide form, show text
                document.querySelector(".ca-modal form").style.display = "none";
                document.querySelector(".ca-modal-content > p#caModalText").style.display = "block";
                document.getElementById("cancelAppointmentForm").style.display = "none";
                // We need an OK button or let the X close it. Let's just use the X.

                modal.hidden = false;
            }

            function openRequestForm() {
                modalTitle.textContent = "Request Appointment";
                modalText.textContent = "Choose a preferred date and time for your appointment.";

                // Show form, hide text
                document.querySelector(".ca-modal form").style.display = "block";
                document.querySelector(".ca-modal-content > p#caModalText").style.display = "block"; // Actually we want this text

                // Set min date to today
                const today = new Date().toISOString().split('T')[0];
                document.getElementById("appointmentDate").min = today;

                modal.hidden = false;
            }

            function closeModal() {
                modal.hidden = true;
            }

            tabs.forEach(button => {
                button.addEventListener("click", () => showTab(button.dataset.tab));
            });

            // View Button Click
            document.addEventListener("click", event => {
                const viewButton = event.target.closest("[data-view]");
                if (viewButton) {
                    // Show simple text details instead of form
                    modalTitle.textContent = "Appointment Details";
                    modalText.textContent = viewButton.dataset.view;

                    // Hide the form if it's there
                    const form = document.querySelector(".ca-modal form");
                    if(form) form.style.display = "none";

                    // Change close button logic to just close
                    document.getElementById("caModalClose").style.display = "block";

                    modal.hidden = false;
                }
            });

            // Request Button Click
            document.getElementById("caRequestBtn").addEventListener("click", () => {
                openRequestForm();
            });

            // Close Modal
            document.getElementById("caModalClose").addEventListener("click", closeModal);
            document.getElementById("cancelAppointmentForm").addEventListener("click", closeModal);
            modal.addEventListener("click", event => {
                if (event.target === modal) closeModal();
            });

            showTab("upcoming");
        })();
    </script>
}