@model HealthTrack.Models.ClientAppointmentsViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Appointments";
    ViewData["Heading"] = "My Appointments";
    ViewData["ActivePage"] = "Appointments";
}

<div class="client-appointments">

    <div class="client-appointments-header">
        <div>
            <h2>My Appointments</h2>
            <p>Manage your appointments and stay on top of your health.</p>
        </div>
        <button type="button" class="ca-request-btn" id="caRequestBtn">
            <i class="bi bi-plus-lg"></i> Request Appointment
        </button>
    </div>

    <div class="ca-card">
        <div class="ca-tabs">
            <button type="button" class="ca-tab active" data-tab="upcoming">Upcoming</button>
            <button type="button" class="ca-tab" data-tab="past">Past Appointments</button>
        </div>

        <div class="ca-table-wrapper">
            <table class="ca-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Trainer</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <!-- UPCOMING APPOINTMENTS -->
                <tbody id="caUpcoming">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            <tr>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@appt.AppointmentDate.ToString("hh:mm tt")</td>
                                <td>@(appt.Trainer?.FullName ?? "Any Available")</td>
                                <td>
                                    <span class="ca-status @appt.Status.ToLower()">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 5px;">
                                        <!-- Direct Cancel Button in Table -->
                                        @if (appt.Status == "Pending" || appt.Status == "Confirmed")
                                        {
                                            <form asp-action="CancelAppointment" asp-controller="ClientDashboard" asp-route-id="@appt.AppointmentId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="ca-action cancel" onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        
                                        <!-- View Button (Opens Modal) -->
                                        <button type="button" class="ca-action view btn-view-appt"
                                                data-id="@appt.AppointmentId"
                                                data-trainer="@(appt.Trainer?.FullName ?? "Any Available")"
                                                data-date="@appt.AppointmentDate.ToString("dd MMM yyyy")"
                                                data-time="@appt.AppointmentDate.ToString("hh:mm tt")"
                                                data-status="@appt.Status"
                                                data-reason="@appt.Reason">
                                            View
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align:center;">No upcoming appointments.</td></tr>
                    }
                </tbody>

                <!-- PAST APPOINTMENTS -->
                <tbody id="caPast" hidden>
                    @if (Model.PastAppointments.Any())
                    {
                        @foreach (var appt in Model.PastAppointments)
                        {
                            <tr>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@appt.AppointmentDate.ToString("hh:mm tt")</td>
                                <td>@(appt.Trainer?.FullName ?? "Any Available")</td>
                                <td>
                                    <span class="ca-status @appt.Status.ToLower()">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="ca-action view btn-view-appt"
                                            data-id="@appt.AppointmentId"
                                            data-trainer="@(appt.Trainer?.FullName ?? "Any Available")"
                                            data-date="@appt.AppointmentDate.ToString("dd MMM yyyy")"
                                            data-time="@appt.AppointmentDate.ToString("hh:mm tt")"
                                            data-status="@appt.Status"
                                            data-reason="@appt.Reason">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align:center;">No past appointments.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ca-footer">
            <span id="caSummary">Showing @Model.UpcomingAppointments.Count upcoming appointments</span>
            <span><i class="bi bi-heart-pulse"></i> HealthTrack</span>
        </div>
    </div>
</div>

<!-- 1. REQUEST APPOINTMENT MODAL -->
<div class="ca-modal" id="caRequestModal" hidden>
    <div class="ca-modal-content">
        <button type="button" class="ca-modal-close" id="caRequestClose" aria-label="Close">&times;</button>

        <div class="ca-modal-icon">
            <i class="bi bi-calendar-check"></i>
        </div>

        <h3>Request Appointment</h3>
        <p class="text-muted small mb-3">Choose a preferred date and time for your appointment.</p>

        <form asp-action="RequestAppointment" asp-controller="ClientDashboard" method="post" style="text-align: left;">
            @Html.AntiForgeryToken()

            <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                <div class="health-form-group" style="flex: 1;">
                    <label>Preferred Date</label>
                    <input type="date" name="appointmentDate" id="appointmentDate" required />
                </div>
                <div class="health-form-group" style="flex: 1;">
                    <label>Preferred Time</label>
                    <input type="time" name="appointmentTime" required />
                </div>
            </div>

            <div class="health-form-group" style="margin-bottom: 15px;">
                <label>Preferred Trainer</label>
                <select name="preferredTrainerId" class="form-control">
                    <option value="">Any available trainer</option>
                    @foreach (var trainer in Model.AvailableTrainers)
                    {
                        <option value="@trainer.Id">@trainer.FullName</option>
                    }
                </select>
            </div>

            <div class="health-form-group" style="margin-bottom: 20px;">
                <label>Reason for appointment</label>
                <textarea name="reason" rows="3" required placeholder="Briefly describe your request"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="health-secondary-button" id="cancelRequestBtn">Cancel</button>
                <button type="submit" class="ca-request-btn">Submit Request</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. VIEW APPOINTMENT DETAILS MODAL -->
<div class="ca-modal" id="caViewModal" hidden>
    <div class="ca-modal-content">
        <button type="button" class="ca-modal-close" id="caViewClose" aria-label="Close">&times;</button>

        <div class="ca-modal-icon">
            <i class="bi bi-info-circle"></i>
        </div>

        <h3>Appointment Details</h3>
        
        <div style="text-align: left; margin-bottom: 20px; background: #f8f9fa; padding: 15px; border-radius: 8px;">
            <p style="margin-bottom: 8px;"><strong>Trainer:</strong> <span id="viewTrainer"></span></p>
            <p style="margin-bottom: 8px;"><strong>Date:</strong> <span id="viewDate"></span></p>
            <p style="margin-bottom: 8px;"><strong>Time:</strong> <span id="viewTime"></span></p>
            <p style="margin-bottom: 8px;"><strong>Status:</strong> <span id="viewStatus" class="ca-status"></span></p>
            <p style="margin-bottom: 0;"><strong>Reason:</strong> <br/> <span id="viewReason" class="text-muted"></span></p>
        </div>

        <!-- Cancel Form inside the View Modal -->
        <form asp-action="CancelAppointment" asp-controller="ClientDashboard" method="post" id="modalCancelForm" style="display: none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="modalAppointmentId" />
            <button type="submit" class="health-secondary-button w-100" style="color: #dc3545; border-color: #dc3545;" onclick="return confirm('Are you sure you want to cancel this appointment?');">
                Cancel This Appointment
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            // Tab Logic
            const upcoming = document.getElementById("caUpcoming");
            const past = document.getElementById("caPast");
            const tabs = document.querySelectorAll(".ca-tab");
            const summary = document.getElementById("caSummary");

            let activeTab = "upcoming";

            function showTab(tab) {
                activeTab = tab;
                tabs.forEach(button => {
                    button.classList.toggle("active", button.dataset.tab === tab);
                });

                upcoming.hidden = tab !== "upcoming";
                past.hidden = tab !== "past";

                if (tab === "upcoming") {
                    summary.textContent = `Showing ${upcoming.querySelectorAll("tr[data-id], tr:not([hidden])").length} upcoming appointments`;
                } else {
                    summary.textContent = `Showing ${past.querySelectorAll("tr").length} past appointments`;
                }
            }

            tabs.forEach(button => {
                button.addEventListener("click", () => showTab(button.dataset.tab));
            });

            // Modals Logic
            const requestModal = document.getElementById("caRequestModal");
            const viewModal = document.getElementById("caViewModal");

            // Request Modal Handlers
            document.getElementById("caRequestBtn").addEventListener("click", () => {
                const today = new Date().toISOString().split('T')[0];
                document.getElementById("appointmentDate").min = today;
                requestModal.hidden = false;
            });
            document.getElementById("caRequestClose").addEventListener("click", () => requestModal.hidden = true);
            document.getElementById("cancelRequestBtn").addEventListener("click", () => requestModal.hidden = true);

            // View Modal Handlers
            document.querySelectorAll(".btn-view-appt").forEach(btn => {
                btn.addEventListener("click", function() {
                    document.getElementById("viewTrainer").textContent = this.dataset.trainer;
                    document.getElementById("viewDate").textContent = this.dataset.date;
                    document.getElementById("viewTime").textContent = this.dataset.time;
                    
                    const status = this.dataset.status;
                    const statusEl = document.getElementById("viewStatus");
                    statusEl.textContent = status;
                    statusEl.className = "ca-status " + status.toLowerCase();
                    
                    document.getElementById("viewReason").textContent = this.dataset.reason;

                    // Show Cancel button if status is Pending or Confirmed
                    const cancelForm = document.getElementById("modalCancelForm");
                    if (status.toLowerCase() === "pending" || status.toLowerCase() === "confirmed") {
                        cancelForm.style.display = "block";
                        document.getElementById("modalAppointmentId").value = this.dataset.id;
                    } else {
                        cancelForm.style.display = "none";
                    }

                    viewModal.hidden = false;
                });
            });
            document.getElementById("caViewClose").addEventListener("click", () => viewModal.hidden = true);

            // Close modals on outside click
            window.addEventListener("click", (e) => {
                if (e.target === requestModal) requestModal.hidden = true;
                if (e.target === viewModal) viewModal.hidden = true;
            });

            showTab("upcoming");
        })();
    </script>
}