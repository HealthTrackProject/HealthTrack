@model HealthTrack.Models.ClientDietViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Diet";
    ViewData["Heading"] = "Diet";
    ViewData["ActivePage"] = "Diet";
}

<section class="health-page diet-page">

    <div class="health-page-header">
        <div>
            <h2>My Diet Plan</h2>
            <p>Track your daily meals and calorie intake.</p>
        </div>

        <button type="button" class="health-primary-button" id="logMealBtn">
            <i class="bi bi-plus-lg"></i> Log Meal
        </button>
    </div>

    <div class="plan-tabs" role="tablist" aria-label="Diet plans">
        <button type="button" class="tab-btn active" data-tab="today" role="tab" aria-selected="true">
            Today's Plan
        </button>
        <button type="button" class="tab-btn" data-tab="history" role="tab" aria-selected="false">
            Meal History
        </button>
    </div>

    <!-- TODAY'S PLAN -->
    <div class="diet-list" id="todayPlanList">
        @foreach (var meal in Model.TodayPlan)
        {
            <article class="diet-item"
                     data-meal-name="@meal.Name"
                     data-meal-time="@meal.Time"
                     data-meal-food="@meal.Food"
                     data-meal-calories="@meal.Calories"
                     data-meal-date="@DateTime.Today.ToString("yyyy-MM-dd")"
                     tabindex="0" role="button" aria-label="View @meal.Name details">

                <img src="@meal.ImageUrl" alt="@meal.Name" class="diet-image" loading="lazy" />

                <div class="diet-info">
                    <h4>@meal.Name</h4>
                    <p><i class="bi bi-clock"></i> @meal.Time</p>
                </div>

                <div class="diet-foods">@meal.Food</div>

                <div class="diet-calories">
                    <strong>@meal.Calories</strong>
                    <span>kcal</span>
                </div>

                <button type="button" class="diet-view-btn" data-meal-view aria-label="View @meal.Name">
                    View
                </button>
            </article>
        }
    </div>

    <!-- MEAL HISTORY (From Database) -->
    <div class="diet-list" id="mealHistoryList" hidden>
        @if (Model.MealHistory.Any())
        {
            @foreach (var meal in Model.MealHistory)
            {
                <article class="diet-item diet-history-item"
                         data-meal-name="@meal.MealType"
                         data-meal-time="@meal.MealDate.ToString("hh:mm tt")"
                         data-meal-food="@meal.FoodDescription"
                         data-meal-calories="@meal.Calories"
                         data-meal-date="@meal.MealDate.ToString("dd MMM yyyy")"
                         tabindex="0" role="button" aria-label="View @meal.MealType history">

                    <div class="diet-history-date">
                        <i class="bi bi-calendar3"></i>
                        <span>@meal.MealDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="diet-info">
                        <h4>@meal.MealType</h4>
                        <p>Meal history</p>
                    </div>

                    <div class="diet-foods">@meal.FoodDescription</div>

                    <div class="diet-calories">
                        <strong>@meal.Calories</strong>
                        <span>kcal</span>
                    </div>

                    <button type="button" class="diet-view-btn" data-meal-view>
                        View
                    </button>
                </article>
            }
        }
        else
        {
            <div class="diet-empty-state" id="dietEmptyState">
                <i class="bi bi-egg-fried"></i>
                <h3>No meals logged yet</h3>
                <p>Use the Log Meal button to add your first meal.</p>
            </div>
        }
    </div>

</section>

<!-- MODAL -->
<div class="ca-modal diet-modal" id="dietModal" hidden>
    <section class="ca-modal-content diet-modal-content" role="dialog" aria-modal="true" aria-labelledby="dietModalTitle">
        <button type="button" class="ca-modal-close" id="dietModalClose" aria-label="Close dialog">
            &times;
        </button>

        <div class="ca-modal-icon">
            <i class="bi bi-egg-fried" id="dietModalIcon"></i>
        </div>

        <h3 id="dietModalTitle">Meal Details</h3>
        <p class="diet-modal-subtitle" id="dietModalSubtitle">View your meal information.</p>

        <!-- FORM VIEW (Hidden by default) -->
        <form id="dietLogForm" asp-action="LogMeal" asp-controller="ClientDashboard" method="post" hidden>
            @Html.AntiForgeryToken()
            <div class="diet-form-grid" style="text-align: left;">
                <div class="health-form-group">
                    <label>Meal Type *</label>
                    <select name="mealType" class="form-control" required>
                        <option value="">Select meal type</option>
                        <option value="Breakfast">Breakfast</option>
                        <option value="Lunch">Lunch</option>
                        <option value="Dinner">Dinner</option>
                        <option value="Snack">Snack</option>
                    </select>
                </div>
                <div class="health-form-group">
                    <label>Calories (kcal) *</label>
                    <input type="number" name="calories" class="form-control" min="0" max="20000" required placeholder="e.g. 450" />
                </div>
                <div class="health-form-group full-width">
                    <label>Food Description *</label>
                    <textarea name="foodDescription" class="form-control" rows="3" required placeholder="e.g. Rice, chicken and vegetables"></textarea>
                </div>
                <div class="health-form-group full-width">
                    <label>Date and Time *</label>
                    <input type="datetime-local" name="mealDate" id="mealDate" class="form-control" required />
                </div>
            </div>

            <div class="diet-modal-footer" style="margin-top: 20px;">
                <button type="button" class="health-secondary-button" id="dietCancelBtn">Cancel</button>
                <button type="submit" class="health-primary-button">Add Meal</button>
            </div>
        </form>

        <!-- DETAILS VIEW (Hidden by default) -->
        <div id="dietDetailsView" hidden>
            <div id="dietModalBody"></div>
            <div class="diet-modal-footer" style="margin-top: 20px;">
                <button type="button" class="health-primary-button" id="dietCloseBtn">Close</button>
            </div>
        </div>

    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/diet-page.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById("dietModal");
            const modalTitle = document.getElementById("dietModalTitle");
            const modalSubtitle = document.getElementById("dietModalSubtitle");
            const modalIcon = document.getElementById("dietModalIcon");

            const formView = document.getElementById("dietLogForm");
            const detailsView = document.getElementById("dietDetailsView");
            const detailsBody = document.getElementById("dietModalBody");

            const logBtn = document.getElementById("logMealBtn");
            const todayList = document.getElementById("todayPlanList");
            const historyList = document.getElementById("mealHistoryList");
            const tabs = [...document.querySelectorAll(".diet-page .tab-btn")];

            // Date setup for form
            const today = new Date();
            const localDateTime = () => {
                const local = new Date(Date.now() - today.getTimezoneOffset() * 60000);
                return local.toISOString().slice(0, 16);
            };

            function openModal(title, subtitle, mode) {
                modalTitle.textContent = title;
                modalSubtitle.textContent = subtitle;

                if (mode === "form") {
                    modalIcon.className = "bi bi-plus-circle";
                    formView.hidden = false;
                    detailsView.hidden = true;
                    document.getElementById("mealDate").value = localDateTime();
                } else {
                    modalIcon.className = "bi bi-egg-fried";
                    formView.hidden = true;
                    detailsView.hidden = false;
                }

                modal.hidden = false;
                document.body.classList.add("modal-open");
            }

            function closeModal() {
                modal.hidden = true;
                document.body.classList.remove("modal-open");
                formView.reset();
            }

            function switchTab(tabName) {
                const showToday = tabName === "today";
                todayList.hidden = !showToday;
                historyList.hidden = showToday;

                tabs.forEach(tab => {
                    const active = tab.dataset.tab === tabName;
                    tab.classList.toggle("active", active);
                    tab.setAttribute("aria-selected", String(active));
                });
            }

            function showMealDetails(card) {
                const values = [
                    ["Meal", card.dataset.mealName || "Not specified"],
                    ["Date", card.dataset.mealDate || "Not specified"],
                    ["Time", card.dataset.mealTime || "Not specified"],
                    ["Calories", `${card.dataset.mealCalories || "0"} kcal`]
                ];

                detailsBody.innerHTML = `<div class="diet-details">
                    ${values.map(([label, value]) => `
                        <div class="diet-detail-row">
                            <span>${label}</span>
                            <strong>${value}</strong>
                        </div>
                    `).join("")}
                    <div class="diet-detail-food">
                        <h4>Food description</h4>
                        <p>${card.dataset.mealFood || "Not specified"}</p>
                    </div>
                </div>`;

                openModal(`${card.dataset.mealName || "Meal"} Details`, "Here are the details for this meal.", "details");
            }

            // Event Listeners
            tabs.forEach(tab => tab.addEventListener("click", () => switchTab(tab.dataset.tab)));

            logBtn.addEventListener("click", () => {
                openModal("Log Meal", "Enter the details of the meal you want to record.", "form");
            });

            document.addEventListener("click", event => {
                const viewButton = event.target.closest("[data-meal-view]");
                if (viewButton) {
                    const card = viewButton.closest(".diet-item");
                    if (card) showMealDetails(card);
                    return;
                }

                const card = event.target.closest(".diet-item[data-meal-name]");
                if (card && !event.target.closest("button")) {
                    showMealDetails(card);
                }
            });

            // Close Modal events
            document.getElementById("dietModalClose").addEventListener("click", closeModal);
            document.getElementById("dietCancelBtn").addEventListener("click", closeModal);
            document.getElementById("dietCloseBtn").addEventListener("click", closeModal);
            modal.addEventListener("click", event => {
                if (event.target === modal) closeModal();
            });

            switchTab("today");
        })();
    </script>
}