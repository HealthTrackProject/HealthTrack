@model HealthTrack.Models.HealthRecordsViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Health Records";
    ViewData["Heading"] = "Health Records";
    ViewData["ActivePage"] = "HealthRecords";
}

<section class="health-page">

    <!-- PAGE HEADER -->
    <div class="health-page-header">
        <div>
            <h2>My Health Records</h2>
            <p>Track your health information and monitor your progress.</p>
        </div>
        <button type="button" class="health-primary-button" onclick="window.print()">
            <i class="bi bi-printer"></i> Print Records
        </button>
    </div>

    <!-- HEALTH SUMMARY -->
    <section class="health-summary-grid">
        <article class="health-summary-card weight">
            <div class="health-summary-icon"><i class="bi bi-person-standing"></i></div>
            <p>Current Weight</p>
            <h3>@Model.CurrentWeight.ToString("0.0") <span>kg</span></h3>
        </article>

        <article class="health-summary-card height">
            <div class="health-summary-icon"><i class="bi bi-rulers"></i></div>
            <p>Height</p>
            <h3>@Model.CurrentHeight.ToString("0.0") <span>cm</span></h3>
        </article>

        <article class="health-summary-card bmi">
            <div class="health-summary-icon"><i class="bi bi-clipboard2-pulse"></i></div>
            <p>Body Mass Index</p>
            <h3>@Model.CurrentBMI.ToString("0.0")</h3>
        </article>

        <article class="health-summary-card heart">
            <div class="health-summary-icon"><i class="bi bi-heart-pulse"></i></div>
            <p>Heart Rate</p>
            <h3>@Model.LastHeartRate <span>bpm</span></h3>
        </article>
    </section>

    <!-- ADD HEALTH RECORD (FORM) -->
    <section class="health-panel">
        <div class="health-panel-header">
            <div>
                <h3>Add Health Record</h3>
                <p>Enter your latest health measurements.</p>
            </div>
            <i class="bi bi-file-earmark-medical"></i>
        </div>

        <!-- Form action added to submit to Controller -->
        <form asp-action="AddHealthRecord" asp-controller="ClientDashboard" method="post">
            @Html.AntiForgeryToken()

            <div class="health-form-grid">
                <div class="health-form-group">
                    <label>Record Date</label>
                    <input type="date" name="recordDate" id="recordDate" required />
                </div>

                <div class="health-form-group">
                    <label>Weight (kg)</label>
                    <input type="number" name="weight" id="weight" min="1" max="500" step="0.1" placeholder="e.g. 72.0" required />
                </div>

                <div class="health-form-group">
                    <label>Height (cm)</label>
                    <input type="number" name="height" id="height" min="30" max="300" step="0.1" placeholder="e.g. 175" required />
                </div>

                <!-- UI has but not in the Database (Optional) -->
                <div class="health-form-group">
                    <label>Blood Pressure</label>
                    <input type="text" id="bloodPressure" pattern="[0-9]{2,3}/[0-9]{2,3}" placeholder="e.g. 120/80" />
                </div>

                <div class="health-form-group">
                    <label>Heart Rate (bpm)</label>
                    <input type="number" id="heartRate" min="1" max="300" placeholder="e.g. 72" />
                </div>

                <div class="health-form-group">
                    <label>Calories Burned</label>
                    <input type="number" name="caloriesBurned" id="caloriesBurned" min="0" max="50000" placeholder="e.g. 350" required />
                </div>
            </div>

            <div class="bmi-preview">
                <i class="bi bi-info-circle"></i>
                <span id="bmiMessage">Enter your weight and height to calculate BMI.</span>
                <strong id="bmiValue"></strong>
            </div>

            <div class="health-form-actions">
                <button type="reset" class="health-secondary-button">Clear Form</button>
                <button type="submit" class="health-primary-button">
                    <i class="bi bi-plus-lg"></i> Add Record
                </button>
            </div>
        </form>
    </section>

    <!-- HEALTH HISTORY TABLE -->
    <section class="health-panel history-panel">
        <div class="health-panel-header">
            <div>
                <h3>Health History</h3>
                <p>Your recorded health measurements.</p>
            </div>
            <span class="record-count" id="recordCount">@Model.Records.Count Records</span>
        </div>

        <div class="health-table-wrapper">
            <table class="health-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Weight</th>
                        <th>Height</th>
                        <th>BMI</th>
                        <th>Blood Pressure</th>
                        <th>Heart Rate</th>
                        <th>Calories</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="healthRecordsBody">
                    @if (Model.Records.Any())
                    {
                        @foreach (var record in Model.Records)
                        {
                            <tr>
                                <td>@record.RecordDate.ToString("yyyy-MM-dd")</td>
                                <td>@record.Weight.ToString("0.0") kg</td>
                                <td>@record.Height.ToString("0.0") cm</td>
                                <td>@record.BMI.ToString("0.0")</td>
                                <td>—</td> <!-- Database doesn't have this field -->
                                <td>—</td> <!-- Database doesn't have this field -->
                                <td>@record.CaloriesBurned</td>
                                <td>
                                    <!-- Delete Button (POST) -->
                                    <form asp-action="DeleteHealthRecord" asp-controller="ClientDashboard" asp-route-id="@record.HealthRecordId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="health-delete-button" onclick="return confirm('Are you sure you want to delete this record?');">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center;">No records found. Add your first record above.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const weightInput = document.getElementById("weight");
            const heightInput = document.getElementById("height");
            const bmiValue = document.getElementById("bmiValue");
            const bmiMessage = document.getElementById("bmiMessage");
            const recordDateInput = document.getElementById("recordDate");

            // Set today's date by default
            if (recordDateInput && !recordDateInput.value) {
                recordDateInput.value = new Date().toLocaleDateString("en-CA");
            }

            // Live BMI Preview Calculation
            function calculateBMI() {
                const weight = Number(weightInput.value);
                const heightCm = Number(heightInput.value);

                if (weight > 0 && heightCm > 0) {
                    const heightM = heightCm / 100;
                    const bmi = weight / (heightM * heightM);
                    bmiValue.textContent = "BMI: " + bmi.toFixed(1);
                    bmiMessage.textContent = "Calculated from the entered weight and height.";
                } else {
                    bmiValue.textContent = "";
                    bmiMessage.textContent = "Enter your weight and height to calculate BMI.";
                }
            }

            weightInput.addEventListener("input", calculateBMI);
            heightInput.addEventListener("input", calculateBMI);
        });
    </script>
}