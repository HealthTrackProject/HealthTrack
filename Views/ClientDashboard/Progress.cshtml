@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Progress";
    ViewData["Heading"] = "My Progress";
    ViewData["ActivePage"] = "Progress";
}

<div class="ht-progress">

    <div class="ht-progress-header">
        <div>
            <h2>My Progress</h2>
            <p>Track your health and fitness journey.</p>
        </div>

        <select id="progressPeriod" class="ht-period-select">
            <option value="3">Last 3 Months</option>
            <option value="6" selected>Last 6 Months</option>
            <option value="12">Last 12 Months</option>
        </select>
    </div>

    <div class="ht-progress-cards">
        <div class="ht-stat-card weight-card">
            <div class="ht-stat-icon"><i class="bi bi-droplet-fill"></i></div>
            <div><span>Weight</span><strong>72 kg</strong></div>
        </div>

        <div class="ht-stat-card bmi-card">
            <div class="ht-stat-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div><span>BMI</span><strong>23.5</strong></div>
        </div>

        <div class="ht-stat-card calories-card">
            <div class="ht-stat-icon"><i class="bi bi-fire"></i></div>
            <div><span>Calories Burned</span><strong>1850</strong></div>
        </div>

        <div class="ht-stat-card workouts-card">
            <div class="ht-stat-icon"><i class="bi bi-lightning-charge-fill"></i></div>
            <div><span>Workouts</span><strong>20</strong></div>
        </div>
    </div>

    <section class="ht-progress-panel">

        <div class="ht-progress-tabs" role="tablist">
            <button type="button" class="ht-progress-tab active" data-chart="weight">
                Weight
            </button>
            <button type="button" class="ht-progress-tab" data-chart="bmi">
                BMI
            </button>
            <button type="button" class="ht-progress-tab" data-chart="calories">
                Calories
            </button>
            <button type="button" class="ht-progress-tab" data-chart="workouts">
                Workouts
            </button>
        </div>

        <div class="ht-chart-container">
            <canvas id="healthProgressChart" aria-label="Health progress chart"></canvas>
        </div>

        <div class="ht-chart-summary">
            <span class="ht-chart-dot"></span>
            <span id="progressChartSummary">
                Weight progress over the last 6 months
            </span>
        </div>
    </section>

    <section class="ht-progress-info">
        <div>
            <h3><i class="bi bi-graph-down-arrow"></i> Progress Overview</h3>
            <p>Your progress summary for the selected period.</p>
        </div>

        <div class="ht-progress-info-value">
            <span>Weight change</span>
            <strong id="weightChange">-10 kg</strong>
        </div>
    </section>

    <div class="ht-progress-note">
        <i class="bi bi-info-circle"></i>
        Demonstration data is shown. Connect your health records to display your actual progress.
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (() => {
            const canvas = document.getElementById("healthProgressChart");
            if (!canvas || typeof Chart === "undefined") return;

            const labels = {
                3: ["Aug", "Sep", "Oct"],
                6: ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
                12: ["Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
                    "Jan", "Feb", "Mar", "Apr", "May", "Jun"]
            };

            const datasets = {
                weight: {
                    label: "Weight (kg)",
                    values: {
                        3: [76, 73, 72],
                        6: [78, 76, 74, 74, 71, 72],
                        12: [82, 81, 80, 79, 78, 77, 76, 75, 74, 73, 72, 72]
                    },
                    summary: "Weight progress over the selected period",
                    change: "-10 kg"
                },
                bmi: {
                    label: "BMI",
                    values: {
                        3: [25.2, 24.1, 23.5],
                        6: [27.1, 26.4, 25.8, 24.9, 24.0, 23.5],
                        12: [29, 28.5, 28, 27.4, 27, 26.5, 26, 25.5, 25, 24.5, 24, 23.5]
                    },
                    summary: "BMI progress over the selected period",
                    change: "-5.5"
                },
                calories: {
                    label: "Calories burned",
                    values: {
                        3: [1500, 1720, 1850],
                        6: [1200, 1400, 1550, 1600, 1750, 1850],
                        12: [900, 1000, 1150, 1200, 1300, 1250, 1400, 1500, 1600, 1700, 1780, 1850]
                    },
                    summary: "Calories burned over the selected period",
                    change: "+650"
                },
                workouts: {
                    label: "Workouts",
                    values: {
                        3: [12, 16, 20],
                        6: [8, 10, 13, 15, 18, 20],
                        12: [4, 5, 7, 8, 9, 11, 12, 14, 15, 17, 18, 20]
                    },
                    summary: "Completed workouts over the selected period",
                    change: "+16"
                }
            };

            let currentChart = "weight";
            let currentPeriod = "6";

            const chart = new Chart(canvas, {
                type: "line",
                data: {
                    labels: labels[currentPeriod],
                    datasets: [{
                        label: datasets[currentChart].label,
                        data: datasets[currentChart].values[currentPeriod],
                        borderColor: "#0ca77c",
                        backgroundColor: context => {
                            const area = context.chart.chartArea;
                            if (!area) return "rgba(12,167,124,0.12)";
                            const gradient = context.chart.ctx.createLinearGradient(
                                0, area.top, 0, area.bottom
                            );
                            gradient.addColorStop(0, "rgba(12,167,124,0.30)");
                            gradient.addColorStop(1, "rgba(12,167,124,0.01)");
                            return gradient;
                        },
                        borderWidth: 2,
                        pointRadius: 2,
                        pointHoverRadius: 5,
                        pointBackgroundColor: "#0ca77c",
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: "index"
                    },
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: {
                                color: "#718494",
                                font: { size: 10 }
                            }
                        },
                        y: {
                            border: { display: false },
                            grid: { color: "#edf2f5" },
                            ticks: {
                                color: "#718494",
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });

            function updateChart() {
                const selected = datasets[currentChart];

                chart.data.labels = labels[currentPeriod];
                chart.data.datasets[0].label = selected.label;
                chart.data.datasets[0].data = selected.values[currentPeriod];

                chart.update();

                document.getElementById("progressChartSummary").textContent =
                    selected.summary;

                document.getElementById("weightChange").textContent =
                    selected.change;
            }

            document.querySelectorAll(".ht-progress-tab").forEach(button => {
                button.addEventListener("click", () => {
                    currentChart = button.dataset.chart;

                    document.querySelectorAll(".ht-progress-tab")
                        .forEach(tab => tab.classList.remove("active"));

                    button.classList.add("active");
                    updateChart();
                });
            });

            document.getElementById("progressPeriod")
                .addEventListener("change", event => {
                    currentPeriod = event.target.value;
                    updateChart();
                });
        })();
    </script>
}
