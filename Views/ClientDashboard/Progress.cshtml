@model HealthTrack.Models.ProgressViewModel
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Progress";
    ViewData["Heading"] = "My Progress";
    ViewData["ActivePage"] = "Progress";
}

<div class="ht-progress">

    <div class="ht-progress-header">
        <div>
            <h2>My Progress</h2>
            <p>Track your health and fitness journey.</p>
        </div>

        <select id="progressPeriod" class="ht-period-select">
            <option value="3">Last 3 Months</option>
            <option value="6" selected>Last 6 Months</option>
            <option value="12">Last 12 Months</option>
        </select>
    </div>

    <div class="ht-progress-cards">
        <div class="ht-stat-card weight-card">
            <div class="ht-stat-icon"><i class="bi bi-droplet-fill"></i></div>
            <div><span>Weight</span><strong>@Model.CurrentWeight.ToString("0.0") kg</strong></div>
        </div>

        <div class="ht-stat-card bmi-card">
            <div class="ht-stat-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div><span>BMI</span><strong>@Model.CurrentBMI.ToString("0.0")</strong></div>
        </div>

        <div class="ht-stat-card calories-card">
            <div class="ht-stat-icon"><i class="bi bi-fire"></i></div>
            <div><span>Calories Burned</span><strong>@Model.TotalCaloriesBurned</strong></div>
        </div>

        <div class="ht-stat-card workouts-card">
            <div class="ht-stat-icon"><i class="bi bi-lightning-charge-fill"></i></div>
            <div><span>Workouts</span><strong>@Model.TotalWorkouts</strong></div>
        </div>
    </div>

    <section class="ht-progress-panel">

        <div class="ht-progress-tabs" role="tablist">
            <button type="button" class="ht-progress-tab active" data-chart="weight">
                Weight
            </button>
            <button type="button" class="ht-progress-tab" data-chart="bmi">
                BMI
            </button>
            <button type="button" class="ht-progress-tab" data-chart="calories">
                Calories
            </button>
            <button type="button" class="ht-progress-tab" data-chart="workouts">
                Workouts
            </button>
        </div>

        <div class="ht-chart-container">
            <canvas id="healthProgressChart" aria-label="Health progress chart"></canvas>
        </div>

        <div class="ht-chart-summary">
            <span class="ht-chart-dot"></span>
            <span id="progressChartSummary">
                Weight progress over the last 6 months
            </span>
        </div>
    </section>

    <section class="ht-progress-info">
        <div>
            <h3><i class="bi bi-graph-down-arrow"></i> Progress Overview</h3>
            <p>Your progress summary for the selected period.</p>
        </div>

        <div class="ht-progress-info-value">
            <span>Weight change</span>
            <strong id="weightChange">@Model.WeightChange</strong>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (() => {
        const canvas = document.getElementById("healthProgressChart");
        if (!canvas || typeof Chart === "undefined") return;

        // C# Data to JS Data
        const allLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels));
        const allWeightData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightData));
        const allBMIData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BMIData));
        const allCaloriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CaloriesData));
        const allWorkoutsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkoutsData));

        const datasets = {
        weight: { label: "Weight (kg)", data: allWeightData, summary: "Weight progress" },
        bmi: { label: "BMI", data: allBMIData, summary: "BMI progress" },
        calories: { label: "Calories burned", data: allCaloriesData, summary: "Calories burned" },
        workouts: { label: "Workouts", data: allWorkoutsData, summary: "Completed workouts" }
        };

        let currentChart = "weight";
        let currentPeriod = 6; // 3, 6, or 12

        // Function to get last N months of data
        function getChartData() {
        const labels = allLabels.slice(-currentPeriod);
        const values = datasets[currentChart].data.slice(-currentPeriod);
        return { labels, values };
        }

        const initialData = getChartData();

        const chart = new Chart(canvas, {
        type: "line",
        data: {
        labels: initialData.labels,
        datasets: [{
        label: datasets[currentChart].label,
        data: initialData.values,
        borderColor: "#0ca77c",
        backgroundColor: context => {
        const area = context.chart.chartArea;
        if (!area) return "rgba(12,167,124,0.12)";
        const gradient = context.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
        gradient.addColorStop(0, "rgba(12,167,124,0.30)");
        gradient.addColorStop(1, "rgba(12,167,124,0.01)");
        return gradient;
        },
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 5,
        pointBackgroundColor: "#0ca77c",
        fill: true,
        tension: 0.35
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { intersect: false, mode: "index" },
        plugins: { legend: { display: false } },
        scales: {
        x: { grid: { display: false }, border: { display: false }, ticks: { color: "#718494", font: { size: 10 } } },
        y: { border: { display: false }, grid: { color: "#edf2f5" }, ticks: { color: "#718494", font: { size: 10 } } }
        }
        }
        });

        function updateChart() {
        const { labels, values } = getChartData();
        chart.data.labels = labels;
        chart.data.datasets[0].label = datasets[currentChart].label;
        chart.data.datasets[0].data = values;
        chart.update();

        document.getElementById("progressChartSummary").textContent =
        `${datasets[currentChart].summary} over the last ${currentPeriod} months`;
        }

        document.querySelectorAll(".ht-progress-tab").forEach(button => {
        button.addEventListener("click", () => {
        currentChart = button.dataset.chart;
        document.querySelectorAll(".ht-progress-tab").forEach(tab => tab.classList.remove("active"));
        button.classList.add("active");
        updateChart();
        });
        });

        document.getElementById("progressPeriod").addEventListener("change", event => {
        currentPeriod = Number(event.target.value);
        updateChart();
        });
        })();
    </script>
}