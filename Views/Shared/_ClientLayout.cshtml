
@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    ViewData["Title"] = "Client Dashboard";
    ViewData["Heading"] = "Welcome, Client";
    ViewData["ActivePage"] = "Dashboard";
}

<section class="welcome-section">
    <div>
        <h2>Your Health Overview</h2>
        <p>Keep moving forward. Every healthy choice matters.</p>
    </div>

    <div class="today-label">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dd MMM yyyy")
    </div>
</section>

<!-- HEALTH STATISTICS -->
<section class="stats-grid">

    <article class="stat-card blue">
        <div class="stat-icon">
            <i class="bi bi-person-standing"></i>
        </div>
        <h3>72 kg</h3>
        <p>Current Weight</p>
    </article>

    <article class="stat-card green">
        <div class="stat-icon">
            <i class="bi bi-clipboard2-check"></i>
        </div>
        <h3>23.5</h3>
        <p>Body Mass Index (BMI)</p>
    </article>

    <article class="stat-card orange">
        <div class="stat-icon">
            <i class="bi bi-activity"></i>
        </div>
        <h3>1850</h3>
        <p>Calories / Day</p>
    </article>

    <article class="stat-card purple">
        <div class="stat-icon">
            <i class="bi bi-hand-thumbs-up"></i>
        </div>
        <h3>5</h3>
        <p>Workouts / Week</p>
    </article>

</section>

<!-- ACTIVITIES AND WEIGHT PROGRESS -->
<section class="dashboard-grid">

    <!-- UPCOMING ACTIVITIES -->
    <article class="content-card">
        <div class="card-header">
            <h3>Upcoming Activities</h3>
            <i class="bi bi-three-dots"></i>
        </div>

        <div class="activity-list">

            <div class="activity-item">
                <div class="activity-icon blue">
                    <i class="bi bi-bicycle"></i>
                </div>

                <div>
                    <h4>Workout - Full Body</h4>
                    <p>Today, 6:00 PM</p>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-icon orange">
                    <i class="bi bi-egg-fried"></i>
                </div>

                <div>
                    <h4>Diet Plan - Lunch</h4>
                    <p>Today, 1:00 PM</p>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-icon purple">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div>
                    <h4>Appointment with Trainer</h4>
                    <p>Tomorrow, 10:00 AM</p>
                </div>
            </div>

        </div>

        <div class="activity-footer">
            <span><i class="bi bi-check-circle"></i> Stay consistent with your goals</span>
        </div>
    </article>

    <!-- WEIGHT PROGRESS -->
    <article class="content-card weight-card">

        <div class="card-header">
            <h3>Weight Progress</h3>

            <select class="card-select" id="weightPeriod"
                    aria-label="Select progress period">
                <option value="6">Last 6 Months</option>
                <option value="3">Last 3 Months</option>
                <option value="12">Last 12 Months</option>
            </select>
        </div>

        <!-- GRAPH -->
        <div class="chart-container">
            <svg class="weight-chart"
                 id="weightChart"
                 viewBox="0 0 360 230"
                 preserveAspectRatio="xMidYMid meet"
                 role="img"
                 aria-label="Weight progress graph">

                <defs>
                    <linearGradient id="weightFill"
                                    x1="0" y1="0"
                                    x2="0" y2="1">
                        <stop offset="0%"
                              stop-color="#20bd79"
                              stop-opacity="0.25" />
                        <stop offset="100%"
                              stop-color="#20bd79"
                              stop-opacity="0.01" />
                    </linearGradient>
                </defs>

                <!-- Horizontal grid lines -->
                <line class="chart-grid-line"
                      x1="42" y1="20" x2="350" y2="20" />

                <line class="chart-grid-line"
                      x1="42" y1="75" x2="350" y2="75" />

                <line class="chart-grid-line"
                      x1="42" y1="130" x2="350" y2="130" />

                <line class="chart-grid-line"
                      x1="42" y1="185" x2="350" y2="185" />

                <!-- Y-axis labels -->
                <text class="chart-label" x="5" y="24">80</text>
                <text class="chart-label" x="5" y="79">75</text>
                <text class="chart-label" x="5" y="134">70</text>
                <text class="chart-label" x="5" y="189">65</text>

                <!-- Filled graph area -->
                <path id="weightArea"
                      d="M42,42
                         L103,64
                         L165,86
                         L226,92
                         L288,119
                         L350,130
                         L350,185
                         L42,185 Z"
                      fill="url(#weightFill)" />

                <!-- Graph line -->
                <polyline id="weightLine"
                          class="chart-line"
                          points="42,42 103,64 165,86 226,92 288,119 350,130" />

                <!-- Latest data point -->
                <circle id="weightPoint"
                        cx="350" cy="130" r="4"
                        fill="#20bd79" />

            </svg>
        </div>

        <!-- SIX MONTH LABELS -->
        <div class="chart-months" id="chartMonths">
            <span>May</span>
            <span>Jun</span>
            <span>Jul</span>
            <span>Aug</span>
            <span>Sep</span>
            <span>Oct</span>
        </div>

        <!-- MONTHLY WEIGHT VALUES -->
        <div class="chart-data-list" id="weightDataList">

            <div>
                <span>May</span>
                <strong>78 kg</strong>
            </div>

            <div>
                <span>June</span>
                <strong>76 kg</strong>
            </div>

            <div>
                <span>July</span>
                <strong>74 kg</strong>
            </div>

            <div>
                <span>August</span>
                <strong>73 kg</strong>
            </div>

            <div>
                <span>September</span>
                <strong>71 kg</strong>
            </div>

            <div>
                <span>October</span>
                <strong>70 kg</strong>
            </div>

        </div>

        <p class="chart-summary">
            <i class="bi bi-arrow-down-right"></i>
            Sample data for UI demonstration
        </p>

    </article>

</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const periodSelect = document.getElementById("weightPeriod");
            const monthContainer = document.getElementById("chartMonths");
            const dataContainer = document.getElementById("weightDataList");
            const line = document.getElementById("weightLine");
            const area = document.getElementById("weightArea");
            const point = document.getElementById("weightPoint");

            const allData = [
                { month: "May", weight: 78 },
                { month: "Jun", weight: 76 },
                { month: "Jul", weight: 74 },
                { month: "Aug", weight: 73 },
                { month: "Sep", weight: 71 },
                { month: "Oct", weight: 70 },
                { month: "Nov", weight: 72 },
                { month: "Dec", weight: 71 },
                { month: "Jan", weight: 70 },
                { month: "Feb", weight: 69 },
                { month: "Mar", weight: 68 },
                { month: "Apr", weight: 67 }
            ];

            function renderWeightChart() {
                const count = Number(periodSelect.value);
                const data = allData.slice(-count);

                const left = 42;
                const right = 350;
                const top = 20;
                const bottom = 185;
                const minWeight = 65;
                const maxWeight = 80;

                const points = data.map((item, index) => {
                    const x = left + (index * (right - left) / (data.length - 1));
                    const y = bottom -
                        ((item.weight - minWeight) /
                        (maxWeight - minWeight)) * (bottom - top);

                    return {
                        x: x,
                        y: y,
                        month: item.month,
                        weight: item.weight
                    };
                });

                const pointString = points
                    .map(p => `${p.x},${p.y}`)
                    .join(" ");

                line.setAttribute("points", pointString);

                const first = points[0];
                const last = points[points.length - 1];

                const areaPath =
                    `M${first.x},${first.y} ` +
                    points.slice(1).map(p => `L${p.x},${p.y}`).join(" ") +
                    ` L${last.x},${bottom} L${first.x},${bottom} Z`;

                area.setAttribute("d", areaPath);

                point.setAttribute("cx", last.x);
                point.setAttribute("cy", last.y);

                monthContainer.innerHTML = "";
                dataContainer.innerHTML = "";

                data.forEach(item => {
                    const monthLabel = document.createElement("span");
                    monthLabel.textContent = item.month;
                    monthContainer.appendChild(monthLabel);

                    const dataItem = document.createElement("div");

                    const monthName = document.createElement("span");
                    monthName.textContent = item.month;

                    const weightValue = document.createElement("strong");
                    weightValue.textContent = `${item.weight} kg`;

                    dataItem.appendChild(monthName);
                    dataItem.appendChild(weightValue);
                    dataContainer.appendChild(dataItem);
                });
            }

            periodSelect.addEventListener("change", renderWeightChart);
            renderWeightChart();
        });
    </script>
}
