
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="@Url.Content("~/css/dashboard.css")" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <span class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>
                <span>HealthTrack</span>
            </a>

            <div class="sidebar-menu">
                <p class="menu-label">MAIN MENU</p>

                <a asp-controller="ClientDashboard" asp-action="Index"
                   class="side-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-house-door"></i>
                    <span>Dashboard</span>
                </a>

                
                <a asp-controller="ClientDashboard"
                   asp-action="HealthRecords"
                   class="side-link @(ViewData["ActivePage"]?.ToString() == "HealthRecords" ? "active" : "")">
                    <i class="bi bi-clipboard2-pulse"></i>
                    <span>Health Records</span>
                </a>


                <a asp-controller="Workout" asp-action="Index"
                   class="side-link">
                    <i class="bi bi-activity"></i>
                    <span>Workout</span>
                </a>

                <a asp-controller="Diet" asp-action="Index"
                   class="side-link">
                    <i class="bi bi-egg-fried"></i>
                    <span>Diet</span>
                </a>

                <a asp-controller="ClientDashboard"
                 asp-action="Appointments"
                class="side-link @(ViewData["ActivePage"]?.ToString() == "Appointments" ? "active" : "")">
                <i class="bi bi-calendar3"></i>
                <span>Appointments</span>
                </a>

                
                <a asp-controller="ClientDashboard"
                   asp-action="Progress"
                   class="side-link @(ViewData["ActivePage"]?.ToString() == "Progress" ? "active" : "")">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Progress</span>
                </a>


                <a asp-controller="Notifications" asp-action="Index"
                   class="side-link">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>

                <a asp-controller="ManageProfile" asp-action="Index"
                   class="side-link">
                    <i class="bi bi-person"></i>
                    <span>My Profile</span>
                </a>
            </div>

            <div class="sidebar-bottom">
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home")"
                      method="post">
                    <button type="submit" class="side-link logout-link">
                        <i class="bi bi-power"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="main-panel">

            <!-- TOPBAR -->
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button"
                            class="menu-toggle"
                            id="menuToggle"
                            aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@(ViewData["Heading"] ?? "Dashboard")</h1>
                        <p class="topbar-subtitle">Your personal health space</p>
                    </div>
                </div>

                <div class="topbar-right">
                    <a asp-controller="Notifications"
                       asp-action="Index"
                       class="notification-button"
                       aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                    </a>

                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
            </header>

            <!-- EACH PAGE'S CONTENT -->
            <main class="page-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script>
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.getElementById("sidebar");

        menuToggle?.addEventListener("click", function () {
            sidebar.classList.toggle("sidebar-open");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
