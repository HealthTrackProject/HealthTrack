@{
    Layout = null;
    ViewData["Title"] = "Contact Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact - HealthTrack</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="/css/contact.css" />
</head>
<body>
    <div class="healthtrack-page">
        <!-- NAVBAR -->
        <header class="ht-navbar">
            <a href="/" class="ht-logo">
                <div class="logo-heart"><i class="bi bi-heart-pulse-fill"></i></div>
                <span>HealthTrack</span>
            </a>
            <nav class="ht-navigation">
                <a href="/">Home</a>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Services">Services</a>
                <a asp-controller="Home" asp-action="Contact" class="active">Contact</a>
            </nav>
            <div class="nav-buttons">
                <a href="/Identity/Account/Login" class="login-btn">Login</a>
                <a href="/Identity/Account/Register" class="register-btn">Register</a>
            </div>
        </header>

        <!-- CONTACT CONTENT -->
        <section class="contact-section">
            <div class="contact-header">
                <h1>Contact <span>Us</span></h1>
                <p>We'd love to hear from you. Reach out with any questions.</p>
            </div>

            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info">
                    <h2>Get In Touch</h2>
                    <p>Our team is here to help you on your health journey.</p>

                    <div class="info-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        <div>
                            <h4>Address</h4>
                            <p>123 Health Street, Colombo, Sri Lanka</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <h4>Email</h4>
                            <p>support@healthtrack.com</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <h4>Phone</h4>
                            <p>+94 11 234 5678</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form">
                    <form action="#" method="post">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" placeholder="John Doe" required />
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" placeholder="john@example.com" required />
                        </div>
                        <div class="form-group">
                            <label>Message</label>
                            <textarea rows="5" placeholder="How can we help you?" required></textarea>
                        </div>
                        <button type="submit" class="get-started">Send Message</button>
                    </form>
                </div>
            </div>
        </section>
    </div>
    <partial name="_Footer" />
</body>
</html>