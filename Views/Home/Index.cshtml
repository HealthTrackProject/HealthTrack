@{
    Layout = null;
    ViewData["Title"] = "HealthTrack Home";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>HealthTrack - Home</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="/css/home.css" />

</head>

<body>

    <div class="healthtrack-page">

        <!-- NAVBAR -->
        <header class="ht-navbar">

            <!-- LOGO -->
            <a href="/" class="ht-logo">

                <div class="logo-heart">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <span>HealthTrack</span>

            </a>


            <!-- NAVIGATION -->
            <nav class="ht-navigation">

                <a href="/" class="active">
                    Home
                </a>

                <a href="#about">
                    About
                </a>

                <a href="#services">
                    Services
                </a>

                <a href="#contact">
                    Contact
                </a>

            </nav>


            <!-- BUTTONS -->
            <div class="nav-buttons">

                <a href="/Identity/Account/Login"
                   class="login-btn">
                    Login
                </a>

                <a href="/Identity/Account/Register"
                   class="register-btn">
                    Register
                </a>

            </div>

        </header>


        <!-- HERO -->
        <section class="hero">

            <!-- LEFT -->
            <div class="hero-content">

                <h1>
                    Your <span>Health</span>
                    <br />
                    Our Priority
                </h1>

                <p>
                    Track your fitness, manage your diet,
                    monitor progress and achieve your goals
                    with HealthTrack.
                </p>

                <a href="/Identity/Account/Register"
                   class="get-started">
                    Get Started
                </a>

            </div>


            <!-- RIGHT IMAGE -->
            <div class="hero-image">

                <img src="/images/health-woman.jpg"
                     alt="Health and Fitness" />

            </div>

        </section>


        <!-- FEATURES -->
        <section class="feature-area">

            <!-- WORKOUT -->
            <div class="feature-card">

                <div class="feature-icon workout">

                    <i class="bi bi-barbell"></i>

                </div>

                <div class="feature-text">

                    <h3>
                        Track Workouts
                    </h3>

                    <p>
                        Stay consistent<br />
                        and reach your goals
                    </p>

                </div>

            </div>


            <!-- DIET -->
            <div class="feature-card">

                <div class="feature-icon diet">

                    <i class="bi bi-apple"></i>

                </div>

                <div class="feature-text">

                    <h3>
                        Manage Diet
                    </h3>

                    <p>
                        Plan healthy meals<br />
                        and track your nutrition
                    </p>

                </div>

            </div>


            <!-- PROGRESS -->
            <div class="feature-card">

                <div class="feature-icon progress">

                    <i class="bi bi-bar-chart-fill"></i>

                </div>

                <div class="feature-text">

                    <h3>
                        Monitor Progress
                    </h3>

                    <p>
                        Visualize your progress<br />
                        with detailed analytics
                    </p>

                </div>

            </div>

        </section>

    </div>

</body>

</html>