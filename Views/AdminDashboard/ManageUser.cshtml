                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&fit=crop" class="table-avatar" alt="Kamal" />
                        <h4>Kamal Perera</h4>
                    </div>
                </td>
                <td>kamal@gmail.com</td>
                <td><span class="badge badge-client">Client</span></td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <div class="action-buttons">
                        <button class="btn-edit">Edit</button>
                        <button class="btn-delete">Delete</button>
                    </div>
                </td>
            </tr>

            <tr data-role="client">
                <td>
                    <div class="table-user-info">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop" class="table-avatar" alt="Nimali" />
                        <h4>Nimali Silva</h4>
                    </div>
                </td>
                <td>nimali@gmail.com</td>
                <td><span class="badge badge-client">Client</span></td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <div class="action-buttons">
                        <button class="btn-edit">Edit</button>
                        <button class="btn-delete">Delete</button>
                    </div>
                </td>
            </tr>

            <tr data-role="trainer">
                <td>
                    <div class="table-user-info">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop" class="table-avatar" alt="John" />
                        <h4>John Silva</h4>
                    </div>
                </td>
                <td>john@gmail.com</td>
                <td><span class="badge badge-trainer">Trainer</span></td>
                <td><span class="badge badge-active">Active</span></td>
                <td>
                    <div class="action-buttons">
                        <button class="btn-edit">Edit</button>
                        <button class="btn-delete">Delete</button>
                    </div>
                </td>
            </tr>

            <tr data-role="trainer">
                <td>
                    <div class="table-user-info">
                        <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop" class="table-avatar" alt="Sarah" />
                        <h4>Sarah Perera</h4>
                    </div>
                </td>
                <td>sarah@gmail.com</td>
                <td><span class="badge badge-trainer">Trainer</span></td>
                <td><span class="badge badge-active">Active</span></td>
