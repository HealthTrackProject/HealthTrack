@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Users";
    ViewData["Heading"] = "Manage Users";
    ViewData["ActivePage"] = "ManageUser";
}

<div class="trainer-page-header">
    <h2>Manage Users</h2>
    <button class="health-primary-button" id="addUserBtn">
        <i class="bi bi-plus-lg"></i> Add User
    </button>
</div>

<!-- TABS & SEARCH BAR -->
<div class="manage-users-controls">
    <div class="admin-tabs">
        <!-- Added data-filter attributes for JavaScript -->
        <button class="admin-tab active" data-filter="all">All Users</button>
        <button class="admin-tab" data-filter="client">Clients</button>
        <button class="admin-tab" data-filter="trainer">Trainers</button>
        <button class="admin-tab" data-filter="admin">Admins</button>
    </div>

    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search users..." />
    </div>
</div>

<!-- USERS TABLE -->
