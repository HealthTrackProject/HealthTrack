@model IEnumerable<HealthTrack.Models.Notification>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Notifications";
    ViewData["Heading"] = "Notifications";
    ViewData["ActivePage"] = "Notifications";

    // Helper function to format dates like "10 minutes ago"
    string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.Now.Subtract(dateTime);
        if (timeSpan <= TimeSpan.FromSeconds(60)) return "just now";
        if (timeSpan <= TimeSpan.FromMinutes(60)) return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} minutes ago" : "1 minute ago";
        if (timeSpan <= TimeSpan.FromHours(24)) return timeSpan.Hours > 1 ? $"{timeSpan.Hours} hours ago" : "1 hour ago";
        if (timeSpan <= TimeSpan.FromDays(30)) return timeSpan.Days > 1 ? $"{timeSpan.Days} days ago" : "1 day ago";
        return dateTime.ToString("dd MMM yyyy");
    }
}

<style>
    /* Add a subtle grey background for unread notifications */
    .notification-item.unread {
        background-color: #fcfcfc;
        border-left: 4px solid #a855f7; /* Purple accent */
    }

    .notification-item {
        transition: background-color 0.2s;
        position: relative;
    }

        .notification-item:hover {
            background-color: #f8f9fa;
        }

    .mark-read-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: none;
        border: none;
        color: #6b7280;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s;
        font-size: 1.2rem;
    }

    .notification-item:hover .mark-read-btn {
        opacity: 1;
    }

    .mark-read-btn:hover {
        color: #10b981;
    }
</style>

<div class="trainer-page-header">
    <div>
        <h2>System Notifications</h2>
    </div>

    @if (Model != null && Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllNotificationsRead" asp-controller="AdminDashboard" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="health-primary-button" style="font-size: 12px; padding: 8px 14px;">
                <i class="bi bi-check2-all"></i> Mark all as read
            </button>
        </form>
    }
</div>

<div class="client-table-wrapper" style="padding: 20px;">
    <div class="notification-list">
        @if (Model != null && Model.Any())
        {
            foreach (var notification in Model)
            {
                // Determine colors and icons based on keywords in the title
                var titleLower = notification.Title.ToLower();
                var iconClass = "bi-bell-fill";
                var colorClass = "purple";

                if (titleLower.Contains("registered") || titleLower.Contains("user"))
                {
                    iconClass = "bi-person-plus-fill";
                    colorClass = "purple";
                }
                else if (titleLower.Contains("backup") || titleLower.Contains("system"))
                {
                    iconClass = "bi-server";
                    colorClass = "green";
                }
                else if (titleLower.Contains("load") || titleLower.Contains("alert") || titleLower.Contains("error"))
                {
                    iconClass = "bi-exclamation-triangle-fill";
                    colorClass = "orange";
                }
                else if (titleLower.Contains("report") || titleLower.Contains("analytics"))
                {
                    iconClass = "bi-calendar-check-fill";
                    colorClass = "blue";
                }

                <div class="notification-item @(notification.IsRead ? "" : "unread")">
                    <div class="notification-icon @colorClass">
                        <i class="bi @iconClass"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-title-row">
                            <h4>@notification.Title</h4>
                            <span>@GetRelativeTime(notification.CreatedAt)</span>
                        </div>
                        <p>@notification.Message</p>
                    </div>

                    @if (!notification.IsRead)
                    {
                        <form asp-action="MarkNotificationRead" asp-controller="AdminDashboard" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@notification.NotificationId" />
                            <button type="submit" class="mark-read-btn" title="Mark as read">
                                <i class="bi bi-check-circle"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 40px 20px; color: #6b7280;">
                <i class="bi bi-bell-slash" style="font-size: 3rem; margin-bottom: 10px; display: block; color: #d1d5db;"></i>
                <h4>No notifications yet</h4>
                <p>When something happens, you'll see it here.</p>
            </div>
        }
    </div>
</div>