@model HealthTrack.ViewModels.TrainerManageProfileViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["Heading"] = "My Profile";
    ViewData["ActivePage"] = "MyProfile";
}

<section class="health-page">

    <div class="health-page-header">
        <button type="button"
                class="health-primary-button"
                id="editProfileBtn">
            <i class="bi bi-pencil-square"></i>
            Edit Profile
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="health-panel">

        <div class="profile-header">

            <div class="profile-avatar-container">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Url.Content(
                         "~/uploads/profiles/" + Model.ProfilePictureUrl)"
                         alt="Trainer Profile Picture"
                         class="profile-img" />
                }
                else
                {
                    <div class="profile-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }

                <button type="button"
                        class="edit-avatar-btn"
                        id="editAvatarBtn"
                        title="Change Profile Picture">
                    <i class="bi bi-camera-fill"></i>
                </button>
            </div>

            <div class="profile-info">
                <h3>@Model.FullName</h3>

                <p>
                    <i class="bi bi-envelope"></i>
                    @Model.Email
                </p>

                <p>
                    <i class="bi bi-telephone"></i>
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "Not provided"
                        : Model.PhoneNumber)
                </p>

                <span class="profile-role"
                      style="background: #e3f2fd; color: #1E88E5;">
                    @ViewBag.Role
                </span>
            </div>

        </div>

        <hr class="profile-divider" />

        <h3 style="margin-bottom: 20px; font-size: 18px; color: var(--text);">
            Professional Information
        </h3>

        <div class="health-summary-grid" style="margin-bottom: 30px;">

            <article class="health-summary-card weight">
                <div class="health-summary-icon">
                    <i class="bi bi-person-badge"></i>
                </div>
                <p>Full Name</p>
                <h3 style="font-size: 18px;">
                    @Model.FullName
                </h3>
            </article>

            <article class="health-summary-card height">
                <div class="health-summary-icon">
                    <i class="bi bi-envelope"></i>
                </div>
                <p>Email Address</p>
                <h3 style="font-size: 15px; overflow-wrap: anywhere;">
                    @Model.Email
                </h3>
            </article>

            <article class="health-summary-card bmi">
                <div class="health-summary-icon">
                    <i class="bi bi-telephone"></i>
                </div>
                <p>Phone Number</p>
                <h3 style="font-size: 18px;">
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "Not provided"
                        : Model.PhoneNumber)
                </h3>
            </article>

            <article class="health-summary-card heart">
                <div class="health-summary-icon">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <p>Account Role</p>
                <h3 style="font-size: 20px;">
                    @ViewBag.Role
                </h3>
            </article>

        </div>

    </div>
</section>

<!-- EDIT PROFILE MODAL -->
<div class="ca-modal" id="editProfileModal" hidden>
    <div class="ca-modal-content"
         style="max-width: 600px; text-align: left;">

        <button type="button"
                class="ca-modal-close"
                id="closeModalBtn"
                aria-label="Close">
            &times;
        </button>

        <h3 style="margin-bottom: 20px; text-align: center;">
            Edit Profile
        </h3>

        <form asp-action="UpdateProfile"
              asp-controller="AdminDashboard"
              method="post">

            @Html.AntiForgeryToken()

            <div class="health-form-grid"
                 style="grid-template-columns: repeat(2, 1fr);">

                <div class="health-form-group">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName"
                           class="form-control"
                           required />
                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="health-form-group">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="e.g. 0771234567" />
                    <span asp-validation-for="PhoneNumber"
                          class="text-danger"></span>
                </div>

                <div class="health-form-group">
                    <label>Email (Cannot be changed)</label>
                    <input asp-for="Email"
                           readonly
                           class="form-control bg-light" />
                </div>

            </div>

            <div style="margin-top: 25px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button"
                        class="health-secondary-button"
                        id="cancelModalBtn">
                    Cancel
                </button>

                <button type="submit"
                        class="health-primary-button">
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

<!-- UPLOAD PROFILE PICTURE MODAL -->
<div class="ca-modal" id="uploadPicModal" hidden>
    <div class="ca-modal-content" style="max-width: 400px;">

        <button type="button"
                class="ca-modal-close"
                id="closePicModalBtn"
                aria-label="Close">
            &times;
        </button>

        <h3 style="margin-bottom: 20px; text-align: center;">
            Update Profile Picture
        </h3>

        <form asp-action="UploadProfilePicture"
              asp-controller="AdminDashboard"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="health-form-group" style="margin-bottom: 20px;">
                <label>Select Image (JPG, PNG)</label>
                <input type="file"
                       name="profilePic"
                       class="form-control"
                       accept=".jpg,.jpeg,.png"
                       required />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button"
                        class="health-secondary-button"
                        id="cancelPicBtn">
                    Cancel
                </button>

                <button type="submit"
                        class="health-primary-button">
                    Upload
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Edit profile modal
            const profileModal =
                document.getElementById("editProfileModal");

            const editBtn =
                document.getElementById("editProfileBtn");

            const closeBtn =
                document.getElementById("closeModalBtn");

            const cancelBtn =
                document.getElementById("cancelModalBtn");

            editBtn.addEventListener("click", function () {
                profileModal.hidden = false;
            });

            function closeProfileModal() {
                profileModal.hidden = true;
            }

            closeBtn.addEventListener("click", closeProfileModal);
            cancelBtn.addEventListener("click", closeProfileModal);

            profileModal.addEventListener("click", function (event) {
                if (event.target === profileModal) {
                    closeProfileModal();
                }
            });

            // Profile picture modal
            const picModal =
                document.getElementById("uploadPicModal");

            const editAvatarBtn =
                document.getElementById("editAvatarBtn");

            const closePicModalBtn =
                document.getElementById("closePicModalBtn");

            const cancelPicBtn =
                document.getElementById("cancelPicBtn");

            editAvatarBtn.addEventListener("click", function () {
                picModal.hidden = false;
            });

            function closePicModal() {
                picModal.hidden = true;
            }

            closePicModalBtn.addEventListener(
                "click", closePicModal
            );

            cancelPicBtn.addEventListener(
                "click", closePicModal
            );

            picModal.addEventListener("click", function (event) {
                if (event.target === picModal) {
                    closePicModal();
                }
            });

            // Escape key closes open modals
            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    closeProfileModal();
                    closePicModal();
                }
            });
        });
    </script>
}
