@model HealthTrack.Models.SystemSetting
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "System Settings";
    ViewData["Heading"] = "System Settings";
    ViewData["ActivePage"] = "SystemSettings";
}

<div class="trainer-page-header">
    <h2>System Configuration</h2>
</div>

<!-- Note: Added method="post" and asp-controller to make it submit properly -->
<form asp-controller="AdminDashboard" asp-action="SystemSettings" method="post" id="settingsForm">

    @Html.AntiForgeryToken()

    <div class="settings-grid">

        <!-- 1. GENERAL SETTINGS -->
        <div class="settings-card">
            <h3><i class="bi bi-gear-fill"></i> General Settings</h3>

            <div class="settings-form-group">
                <label>System Name</label>
                <input asp-for="SystemName" type="text" required />
            </div>

            <div class="settings-form-group">
                <label>Support Email</label>
                <input asp-for="SupportEmail" type="email" required />
            </div>

            <div class="settings-form-group">
                <label>Default Timezone</label>
                <select asp-for="DefaultTimezone">
                    <option value="UTC">UTC (Coordinated Universal Time)</option>
                    <option value="IST">IST (India Standard Time / Sri Lanka)</option>
                    <option value="EST">EST (Eastern Standard Time)</option>
                </select>
            </div>
        </div>

        <!-- 2. SECURITY & PRIVACY -->
        <div class="settings-card">
            <h3><i class="bi bi-shield-lock-fill"></i> Security & Privacy</h3>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>Two-Factor Authentication (2FA)</h4>
                    <p>Require 2FA for all Admin accounts.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="TwoFactorAuth" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>Maintenance Mode</h4>
                    <p>Prevent users from accessing the system temporarily.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="MaintenanceMode" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>Force Password Reset</h4>
                    <p>Prompt all users to update their passwords every 90 days.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="ForcePasswordReset" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>
        </div>

        <!-- 3. NOTIFICATIONS -->
        <div class="settings-card">
            <h3><i class="bi bi-bell-fill"></i> Notification Settings</h3>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>Email Notifications</h4>
                    <p>Send automatic emails for appointments and updates.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="EmailNotifications" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>SMS Alerts</h4>
                    <p>Send SMS alerts to clients and trainers for reminders.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="SmsAlerts" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>
        </div>

        <!-- 4. SYSTEM PREFERENCES -->
        <div class="settings-card">
            <h3><i class="bi bi-sliders"></i> System Preferences</h3>

            <div class="settings-form-group">
                <label>Max Upload Size (MB)</label>
                <input asp-for="MaxUploadSize" type="number" min="1" max="100" required />
            </div>

            <div class="settings-toggle-row">
                <div class="toggle-info">
                    <h4>Allow User Registration</h4>
                    <p>Allow new users to create accounts.</p>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="AllowUserRegistration" class="form-check-input" type="checkbox" role="switch">
                </div>
            </div>
        </div>

    </div>

    <!-- SAVE BUTTON -->
    <div class="settings-actions">
        <button type="submit" class="health-primary-button" style="padding: 12px 30px; font-size: 14px;">
            <i class="bi bi-save-fill"></i> Save All Settings
        </button>
    </div>
</form>

@section Scripts {
    <!-- No fake JavaScript needed anymore, the form submits naturally to the database -->
}