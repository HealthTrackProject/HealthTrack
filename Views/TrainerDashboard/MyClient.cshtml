@model List<HealthTrack.ViewModels.TrainerClientViewModel>

@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "My Clients";
    ViewData["Heading"] = "Manage Clients";
    ViewData["ActivePage"] = "MyClients";
}

<div class="clients-toolbar">
    <div class="search-container">
        <i class="bi bi-search"></i>
        <input type="search"
               id="clientSearch"
               placeholder="Search clients by name or email..."
               aria-label="Search clients" />
    </div>

    <span class="clients-count">
        <i class="bi bi-people"></i>
        <span id="clientCount">@Model.Count</span> clients
    </span>
</div>

<div class="client-table-wrapper">
    <table class="client-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Progress</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="clientTableBody">

            @if (Model.Any())
            {
                foreach (var client in Model)
                {
                    var name = string.IsNullOrWhiteSpace(client.FullName)
                        ? "Client"
                        : client.FullName;

                    var pictureUrl = string.IsNullOrWhiteSpace(client.ProfilePictureUrl)
                        ? null
                        : (
                            client.ProfilePictureUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                            client.ProfilePictureUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                            client.ProfilePictureUrl.StartsWith("/", StringComparison.Ordinal)
                          )
                            ? client.ProfilePictureUrl
                            : Url.Content("~/uploads/profiles/" + client.ProfilePictureUrl);

                    <tr data-client-id="@client.Id"
                        data-name="@name"
                        data-email="@(client.Email ?? "")"
                        data-progress="@client.WorkoutsCompleted"
                        data-phone="@(client.PhoneNumber ?? "Not provided")"
                        data-goal="Not specified in the available data"
                        data-health="@client.HealthSummary">

                        <td>
                            <div class="table-user-info">

                                @if (!string.IsNullOrWhiteSpace(pictureUrl))
                                {
                                    <img src="@pictureUrl"
                                         alt="@name"
                                         class="table-avatar"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                    <div class="table-avatar avatar-placeholder"
                                         style="display:none;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-avatar avatar-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }

                                <div>
                                    <h4>@name</h4>
                                    <p>Client</p>
                                </div>

                            </div>
                        </td>

                        <td class="client-email">
                            @(client.Email ?? "No email available")
                        </td>

                        <td>
                            <div class="progress-cell">
                                <span class="progress-text">
                                    @client.WorkoutsCompleted workouts completed
                                </span>
                            </div>
                        </td>

                        <td>
                          <div class="client-actions">
                            <button type="button"
                                    class="btn-view-outline"
                                    data-client-action="view"
                                    data-client-id="@client.Id">
                                View
                            </button>

                            <button type="button"
        class="health-secondary-button"
        data-client-action="workout"
        data-client-id="@client.Id">
    Assign workout
</button>

<button type="button"
        class="health-secondary-button"
        data-client-action="diet"
        data-client-id="@client.Id">
    Assign diet plan
</button>
                        </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr id="emptyClientsRow">
                    <td colspan="4" style="text-align:center; padding:25px;">
                        <i class="bi bi-people" style="font-size:28px;"></i>
                        <p>No clients are currently assigned to you.</p>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <p id="noSearchResults"
       style="display:none; text-align:center; padding:20px;">
        No matching clients found.
    </p>
</div>

<style>
    .avatar-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f5ee;
        color: var(--primary);
        font-size: 22px;
        flex-shrink: 0;
    }

    .progress-cell {
        min-width: 120px;
    }

    .progress-text {
        font-size: 13px;
    }

    .client-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
</style>

<div id="trainerAssignmentConfig"
     hidden
     data-workout-url="@Url.Action("AssignWorkout", "TrainerDashboard")"
     data-diet-url="@Url.Action("AssignDietPlan", "TrainerDashboard")">
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script src="~/js/trainer-dashboard-popups.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("clientSearch");
            const tableBody = document.getElementById("clientTableBody");
            const clientCount = document.getElementById("clientCount");
            const noResults = document.getElementById("noSearchResults");

            if (!searchInput || !tableBody || !clientCount || !noResults) {
                return;
            }

            const rows = Array.from(
                tableBody.querySelectorAll("tr[data-client-id]")
            );

            function filterClients() {
                const query = searchInput.value.trim().toLowerCase();
                let visible = 0;

                rows.forEach(function (row) {
                    const name = (row.dataset.name || "").toLowerCase();
                    const email = (row.dataset.email || "").toLowerCase();
                    const matches = name.includes(query) || email.includes(query);

                    row.style.display = matches ? "" : "none";

                    if (matches) visible++;
                });

                clientCount.textContent = visible;
                noResults.style.display =
                    rows.length > 0 && visible === 0 ? "block" : "none";
            }

            searchInput.addEventListener("input", filterClients);
            filterClients();
        });
    </script>
}
}