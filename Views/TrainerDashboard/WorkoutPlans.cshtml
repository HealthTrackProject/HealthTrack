@model HealthTrack.ViewModels.TrainerWorkoutPlanViewModel

@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Workout Plans";
    ViewData["Heading"] = "Workout Plans";
    ViewData["ActivePage"] = "WorkoutPlans";
}

<div class="workout-form-container">

    <div class="form-page-heading">
        <h2><i class="bi bi-activity"></i> Create Workout Plan</h2>
        <p>Choose a client, set the plan dates, and build a workout schedule for each day.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form asp-controller="TrainerDashboard"
          asp-action="WorkoutPlans"
          method="post"
          id="workoutPlanForm">

        @Html.AntiForgeryToken()

        <!-- Client: label and dropdown on the same row -->
        <div class="form-group-row">
            <label asp-for="ClientId">Select Client</label>
            <div class="field-control">
                <select asp-for="ClientId"
                        asp-items="Model.Clients"
                        class="form-control">
                    <option value="">-- Select a Client --</option>
                </select>
                <span asp-validation-for="ClientId" class="validation-error"></span>
            </div>
        </div>

        <!-- Plan name: label and textbox on the same row -->
        <div class="form-group-row">
            <label asp-for="PlanName">Plan Name</label>
            <div class="field-control">
                <input asp-for="PlanName"
                       class="form-control"
                       placeholder="e.g. Weight Loss Plan" />
                <span asp-validation-for="PlanName" class="validation-error"></span>
            </div>
        </div>

        <!-- Description -->
        <div class="form-group-row">
            <label asp-for="Description">Description</label>
            <div class="field-control">
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"
                          placeholder="Describe the workout plan"></textarea>
            </div>
        </div>

        <!-- Start date -->
        <div class="form-group-row">
            <label asp-for="StartDate">Start Date</label>
            <div class="field-control">
                <input asp-for="StartDate"
                       type="date"
                       asp-format="{0:yyyy-MM-dd}"
                       class="form-control" />
                <span asp-validation-for="StartDate" class="validation-error"></span>
            </div>
        </div>

        <!-- End date -->
        <div class="form-group-row">
            <label asp-for="EndDate">End Date</label>
            <div class="field-control">
                <input asp-for="EndDate"
                       type="date"
                       asp-format="{0:yyyy-MM-dd}"
                       class="form-control" />
                <span asp-validation-for="EndDate" class="validation-error"></span>
            </div>
        </div>

        <!-- Horizontal workout schedule -->
        <div class="schedule-section">

            <div class="schedule-label">
                <label>Workout Schedule</label>
                <p>Add exercises for each day. Scroll horizontally to view all days.</p>
            </div>

            <div class="schedule-content">

                <div id="schedule-container">

                    @for (int i = 0; i < Model.Days.Count; i++)
                    {
                        <div class="schedule-item">

                            <div class="day-card-header">
                                <strong class="day-heading">Day @(i + 1)</strong>

                                <button type="button"
                                        class="btn-delete-day"
                                        title="Remove day"
                                        aria-label="Remove workout day">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <input type="hidden"
                                   name="Days[@i].DayNumber"
                                   value="@(i + 1)" />

                            <div class="schedule-fields">

                                <label>Day Name</label>
                                <select name="Days[@i].DayName"
                                        class="form-control day-name">
                                    @foreach (var day in new[]
                                    {
                                        "Monday", "Tuesday", "Wednesday",
                                        "Thursday", "Friday", "Saturday", "Sunday"
                                    })
                                    {
                                        if (Model.Days[i].DayName == day)
                                        {
                                            <option value="@day" selected>@day</option>
                                        }
                                        else
                                        {
                                            <option value="@day">@day</option>
                                        }
                                    }
                                </select>

                                <label>Muscle Group</label>
                                <input name="Days[@i].MuscleGroup"
                                       value="@Model.Days[i].MuscleGroup"
                                       class="form-control"
                                       placeholder="e.g. Chest & Arms" />

                                <label>Exercises</label>
                                <textarea name="Days[@i].Exercises"
                                          class="form-control exercise-input"
                                          rows="4"
                                          placeholder="Enter exercises">@Model.Days[i].Exercises</textarea>

                            </div>
                        </div>
                    }

                </div>

                <div class="schedule-footer">
                    <button type="button"
                            class="btn-add-day"
                            id="addDayBtn">
                        <i class="bi bi-plus-circle"></i>
                        Add Day
                    </button>

                    <span class="schedule-hint">
                        <i class="bi bi-arrow-left-right"></i>
                        Maximum 7 days
                    </span>
                </div>

                <p id="scheduleError" class="validation-error"></p>
            </div>
        </div>

        <!-- Save -->
        <div class="form-actions-bottom">
            <button type="submit" class="btn-save-plan">
                <i class="bi bi-check-circle"></i>
                Save Workout Plan
            </button>
        </div>

    </form>
</div>

<style>
    .workout-form-container {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 30px;
        margin-bottom: 30px;
        background: #fff;
        border: 1px solid #e3ebf4;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(25, 65, 110, .05);
    }

    .form-page-heading {
        margin-bottom: 32px;
    }

        .form-page-heading h2 {
            margin: 0 0 8px;
            color: #173b63;
            font-size: 28px;
            font-weight: 750;
        }

            .form-page-heading h2 i {
                color: #2580d8;
                margin-right: 8px;
            }

        .form-page-heading p {
            margin: 0;
            color: #71839a;
            line-height: 1.6;
        }

    /* Each label and its input are displayed side by side. */
    .form-group-row {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        align-items: start;
        gap: 20px;
        width: 100%;
        margin-bottom: 24px;
        min-width: 0;
    }

        .form-group-row > label {
            padding-top: 13px;
            color: #243b53;
            font-weight: 650;
        }

    .field-control {
        width: 100%;
        min-width: 0;
    }

    .form-control {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 50px;
        padding: 12px 15px;
        box-sizing: border-box;
        color: #243447;
        background: #fff;
        border: 1px solid #d8e3ef;
        border-radius: 10px;
        font: inherit;
        transition: border-color .2s, box-shadow .2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #2580d8;
            box-shadow: 0 0 0 3px rgba(37, 128, 216, .12);
        }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
        line-height: 1.6;
    }

    .validation-error,
    .validation-summary {
        display: block;
        margin-top: 6px;
        color: #b42318;
        font-size: 13px;
    }

        .validation-summary:empty {
            display: none;
        }

    .validation-summary {
        margin-bottom: 16px;
    }

    .alert-success {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        margin-bottom: 20px;
        color: #067647;
        background: #ecfdf3;
        border: 1px solid #abefc6;
        border-radius: 10px;
    }

    /* Schedule section */
    .schedule-section {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        align-items: start;
        gap: 20px;
        margin-top: 32px;
        min-width: 0;
    }

    .schedule-label {
        padding-top: 8px;
    }

        .schedule-label > label {
            display: block;
            margin-bottom: 8px;
            color: #243b53;
            font-weight: 700;
        }

        .schedule-label p {
            margin: 0;
            color: #71839a;
            font-size: 13px;
            line-height: 1.6;
        }

    .schedule-content {
        width: 100%;
        min-width: 0;
    }

    /* Day cards flow horizontally in one row. */
    #schedule-container {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(285px, 320px);
        grid-template-rows: auto;
        gap: 16px;
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 4px 4px 16px;
        box-sizing: border-box;
        scroll-snap-type: x proximity;
        scrollbar-width: thin;
        scrollbar-color: #a9c6e7 #edf3fa;
    }

        #schedule-container::-webkit-scrollbar {
            height: 8px;
        }

        #schedule-container::-webkit-scrollbar-track {
            background: #edf3fa;
            border-radius: 10px;
        }

        #schedule-container::-webkit-scrollbar-thumb {
            background: #a9c6e7;
            border-radius: 10px;
        }

    .schedule-item {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
        padding: 18px;
        box-sizing: border-box;
        background: linear-gradient(180deg, #f7faff, #fff);
        border: 1px solid #dce7f3;
        border-radius: 13px;
        scroll-snap-align: start;
        transition: border-color .2s, box-shadow .2s;
    }

        .schedule-item:hover {
            border-color: #a8cbee;
            box-shadow: 0 5px 15px rgba(37, 100, 170, .07);
        }

    .day-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-bottom: 13px;
        border-bottom: 1px solid #e5edf6;
    }

    .day-heading {
        color: #1769aa;
        font-size: 18px;
        font-weight: 750;
    }

    .schedule-fields {
        display: flex;
        flex-direction: column;
        gap: 9px;
        min-width: 0;
    }

        .schedule-fields label {
            margin-top: 2px;
            color: #243b53;
            font-size: 14px;
            font-weight: 650;
        }

        .schedule-fields .form-control {
            min-height: 44px;
            padding: 10px 11px;
            font-size: 14px;
        }

        .schedule-fields .exercise-input {
            min-height: 115px;
        }

    .btn-add-day,
    .btn-delete-day,
    .btn-save-plan {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font: inherit;
        font-weight: 650;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-add-day {
        padding: 11px 17px;
        color: #1769aa;
        background: #fff;
        border: 1px solid #78afe5;
        border-radius: 9px;
    }

        .btn-add-day:hover {
            color: #fff;
            background: #1769aa;
        }

        .btn-add-day:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .btn-delete-day {
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        padding: 0;
        color: #d92d20;
        background: #fff1f0;
        border: 1px solid #ffd5d2;
        border-radius: 9px;
    }

        .btn-delete-day:hover {
            color: #fff;
            background: #d92d20;
        }

    .schedule-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 10px;
    }

    .schedule-hint {
        color: #71839a;
        font-size: 12px;
    }

    .form-actions-bottom {
        display: flex;
        justify-content: flex-end;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf1f6;
    }

    .btn-save-plan {
        padding: 13px 24px;
        color: #fff;
        background: linear-gradient(135deg, #1769aa, #2585dc);
        border: none;
        border-radius: 9px;
        box-shadow: 0 4px 10px rgba(23, 105, 170, .15);
    }

        .btn-save-plan:hover {
            background: #12568f;
            transform: translateY(-1px);
        }

    @@media (max-width: 900px) {
        .form-group-row,
        .schedule-section {
            grid-template-columns: 1fr;
            gap: 9px;
        }

            .form-group-row > label {
                padding-top: 0;
            }

        .schedule-label {
            padding-top: 0;
        }
    }

    @@media (max-width: 600px) {
        .workout-form-container {
            padding: 16px;
        }

        .form-page-heading h2 {
            font-size: 23px;
        }

        #schedule-container {
            grid-auto-columns: minmax(260px, 85%);
        }

        .schedule-item {
            padding: 15px;
        }

        .schedule-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-actions-bottom {
            justify-content: stretch;
        }

        .btn-save-plan {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("workoutPlanForm");
            const container = document.getElementById("schedule-container");
            const addButton = document.getElementById("addDayBtn");
            const error = document.getElementById("scheduleError");

            const daysOfWeek = [
                "Monday", "Tuesday", "Wednesday", "Thursday",
                "Friday", "Saturday", "Sunday"
            ];

            function reindexDays() {
                const items = container.querySelectorAll(".schedule-item");

                items.forEach((item, index) => {
                    item.querySelector(".day-heading").textContent =
                        `Day ${index + 1}`;

                    item.querySelectorAll("[name]").forEach(input => {
                        input.name = input.name.replace(
                            /Days\[\d+\]/g,
                            `Days[${index}]`
                        );
                    });

                    const numberInput =
                        item.querySelector('input[name$=".DayNumber"]');

                    if (numberInput) {
                        numberInput.value = index + 1;
                    }
                });

                addButton.disabled = items.length >= 7;
                addButton.title = items.length >= 7
                    ? "Maximum seven days allowed"
                    : "Add a workout day";
            }

            function createDay(index) {
                const item = document.createElement("div");
                item.className = "schedule-item";

                const nextDay = daysOfWeek[index % 7];

                item.innerHTML = `
                            <div class="day-card-header">
                                <strong class="day-heading">Day ${index + 1}</strong>
                                <button type="button"
                                        class="btn-delete-day"
                                        title="Remove day"
                                        aria-label="Remove workout day">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <input type="hidden"
                                   name="Days[${index}].DayNumber"
                                   value="${index + 1}">

                            <div class="schedule-fields">
                                <label>Day Name</label>
                                <select name="Days[${index}].DayName"
                                        class="form-control day-name">
                                    ${daysOfWeek.map(day =>
                    `<option value="${day}" ${day === nextDay ? "selected" : ""}>${day}</option>`
                ).join("")}
                                </select>

                                <label>Muscle Group</label>
                                <input name="Days[${index}].MuscleGroup"
                                       class="form-control"
                                       placeholder="e.g. Legs & Core">

                                <label>Exercises</label>
                                <textarea name="Days[${index}].Exercises"
                                          class="form-control exercise-input"
                                          rows="4"
                                          placeholder="Enter exercises"></textarea>
                            </div>
                        `;

                return item;
            }

            addButton.addEventListener("click", function () {
                const count =
                    container.querySelectorAll(".schedule-item").length;

                if (count >= 7) {
                    error.textContent =
                        "You can add a maximum of seven days.";
                    return;
                }

                error.textContent = "";

                const newItem = createDay(count);
                container.appendChild(newItem);
                reindexDays();

                newItem.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                    inline: "end"
                });
            });

            container.addEventListener("click", function (event) {
                const button = event.target.closest(".btn-delete-day");

                if (!button) return;

                button.closest(".schedule-item").remove();
                reindexDays();
                error.textContent = "";
            });

            form.addEventListener("submit", function (event) {
                reindexDays();

                const count =
                    container.querySelectorAll(".schedule-item").length;

                if (count === 0) {
                    event.preventDefault();
                    error.textContent =
                        "Please add at least one workout day.";
                } else if (count > 7) {
                    event.preventDefault();
                    error.textContent =
                        "You can add a maximum of seven days.";
                }
            });

            reindexDays();
        });
    </script>
}
