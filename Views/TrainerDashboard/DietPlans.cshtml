@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Diet Plans";
    ViewData["Heading"] = "Diet Plans";
    ViewData["ActivePage"] = "DietPlans";
}

<div class="trainer-page-header">
    <h2>Create Diet Plan</h2>
</div>

<div class="workout-form-container">
    <form action="#" method="post">

        <!-- Select Client -->
        <div class="form-group-row">
            <label>Select Client</label>
            <select class="form-control">
                <option value="">-- Select a Client --</option>
                <option value="1">Kamal Perera</option>
                <option value="2">Nimali Silva</option>
                <option value="3">Sahan Fernando</option>
            </select>
        </div>

        <!-- Plan Name -->
        <div class="form-group-row">
            <label>Plan Name</label>
            <input type="text" class="form-control" placeholder="e.g. Keto Diet Plan" />
        </div>

        <!-- Description -->
        <div class="form-group-row">
            <label>Description</label>
            <textarea class="form-control" rows="3" placeholder="e.g. High protein, low carb diet plan"></textarea>
        </div>

        <!-- Schedule Section (Meals) -->
        <div class="schedule-section">
            <div class="form-group-row">
                <label>Schedule</label>
                <div style="flex: 1;">
                    <div id="diet-schedule-container">

                        <!-- Breakfast (Default Row) -->
                        <div class="schedule-item">
                            <div class="schedule-day-info">
                                <strong>Breakfast</strong>
                                <span>8:00 AM</span>
                            </div>
                            <textarea class="form-control" rows="2">Oatmeal, Banana, Almonds</textarea>
                            <button type="button" class="btn-delete-day" onclick="this.parentElement.remove()">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                        <!-- Lunch (Default Row) -->
                        <div class="schedule-item">
                            <div class="schedule-day-info">
                                <strong>Lunch</strong>
                                <span>1:00 PM</span>
                            </div>
                            <textarea class="form-control" rows="2">Grilled Chicken, Brown Rice, Salad</textarea>
                            <button type="button" class="btn-delete-day" onclick="this.parentElement.remove()">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                    </div>

                    <!-- Add Meal Button -->
                    <button type="button" class="btn-add-day" id="addMealBtn">
                        <i class="bi bi-plus"></i> Add Meal
                    </button>
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <div class="form-actions-bottom">
            <button type="submit" class="btn-save-plan">Save Plan</button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const addMealBtn = document.getElementById("addMealBtn");
            const scheduleContainer = document.getElementById("diet-schedule-container");

            // Standard meal types to cycle through
            const mealTypes = [
                { name: "Snacks", time: "4:00 PM" },
                { name: "Pre-Workout", time: "5:30 PM" },
                { name: "Dinner", time: "8:00 PM" },
                { name: "Late Night Snack", time: "10:00 PM" }
            ];
            let mealIndex = 0;

            addMealBtn.addEventListener("click", function () {
                if (mealIndex >= mealTypes.length) {
                    alert("You have added all standard meals.");
                    return;
                }

                const meal = mealTypes[mealIndex];
                mealIndex++;

                // Create new schedule item HTML
                const newRow = document.createElement("div");
                newRow.className = "schedule-item";
                newRow.innerHTML = `
                    <div class="schedule-day-info">
                        <strong>${meal.name}</strong>
                        <span>${meal.time}</span>
                    </div>
                    <textarea class="form-control" rows="2" placeholder="Enter meal details..."></textarea>
                    <button type="button" class="btn-delete-day" onclick="this.parentElement.remove(); mealIndex--;">
                        <i class="bi bi-trash"></i>
                    </button>
                `;

                // Append to container
                scheduleContainer.appendChild(newRow);
            });
        });
    </script>
}