@model HealthTrack.ViewModels.TrainerFeedbackViewModel

@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Feedback";
    ViewData["Heading"] = "Client Feedback";
    ViewData["ActivePage"] = "Feedback";
}

<div class="feedback-grid">

    <!-- LEFT: Give New Feedback -->
    <div class="feedback-card">
        <h3>
            <i class="bi bi-chat-left-text-fill"></i>
            Give New Feedback
        </h3>

        <form id="feedbackForm"
              asp-controller="TrainerDashboard"
              asp-action="SubmitFeedback"
              method="post">

            @Html.AntiForgeryToken()

            <div class="feedback-form-group">
                <label for="clientSelect">Select Client</label>

                <select id="clientSelect" name="ClientId" required>
                    <option value="">-- Choose a Client --</option>

                    @foreach (var client in Model.Clients)
                    {
                        <option value="@client.Value">
                            @client.Text
                        </option>
                    }
                </select>
            </div>

            <div class="feedback-form-group">
                <label for="feedbackMessage">Feedback Message</label>

                <textarea id="feedbackMessage"
                          name="Message"
                          maxlength="2000"
                          placeholder="Enter feedback for your client..."
                          required></textarea>
            </div>

            <button type="submit"
                    id="submitFeedbackButton"
                    class="health-primary-button"
                    style="width: 100%;">
                <i class="bi bi-send-fill"></i>
                Submit Feedback
            </button>

            <p id="feedbackStatus"
               role="status"
               aria-live="polite"
               style="margin-top: 12px;"></p>
        </form>
    </div>

    <!-- RIGHT: Recent Feedback -->
    <div class="feedback-card">
        <h3>
            <i class="bi bi-clock-history"></i>
            Recent Feedback
        </h3>

        <div class="recent-feedback-list" id="feedbackList">

            @if (Model.RecentFeedback.Any())
            {
                foreach (var feedback in Model.RecentFeedback)
                {
                    <div class="feedback-item">
                        <div class="feedback-item-header">
                            <h4>
                                @(string.IsNullOrWhiteSpace(
                                    feedback.Client?.FullName)
                                    ? "Client"
                                    : feedback.Client.FullName)
                            </h4>

                            <span>
                                @feedback.CreatedAt
                              
                            </span>
                        </div>

                        <p style="white-space: pre-wrap;">@feedback.Message</p>
                    </div>
                }
            }
            else
            {
                <p id="noFeedbackMessage">
                    No feedback has been submitted yet.
                </p>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("feedbackForm");
            const clientSelect = document.getElementById("clientSelect");
            const feedbackMessage = document.getElementById("feedbackMessage");
            const feedbackList = document.getElementById("feedbackList");
            const submitButton = document.getElementById("submitFeedbackButton");
            const statusMessage = document.getElementById("feedbackStatus");

            form.addEventListener("submit", async function (event) {
                event.preventDefault();

                if (!form.reportValidity()) {
                    return;
                }

                if (!clientSelect.value || !feedbackMessage.value.trim()) {
                        statusMessage.textContent =
                         "Please select a client and enter feedback.";
                            return;
                    }

                    const originalButtonText = submitButton.innerHTML;

                        submitButton.disabled = true;
                   submitButton.textContent = "Submitting...";
                        statusMessage.textContent = "";

                    try {
                            const response = await fetch(form.action, {
                                method: "POST",                  body: new FormData(form),
                                   credentials: "same-origin",
                                headers: {
                               "X-Requested-With": "XMLHttpRequest",
                                "Accept": "application/json"
                            }
                        });

                       const result = await response.json().catch(() => null);

                        if (!response.ok ||
                            !result ||
                            !result.success ||
                                !result.feedback) {
                        throw new Error(
                                    result?.message ||
                                "Unable to submit feedback. Please try again."
                          );
                            }

                                const feedback = result.feedback;

                        const emptyMessage =
                                document.getElementById("noFeedbackMessage");

                        if (emptyMessage) {
                            emptyMessage.remove();
                        }

                        // Create the new feedback item safely.
                           const item = document.createElement("div");
                            item.className = "feedback-item";

                        const header = document.createElement("div");
                        header.className = "feedback-item-header";

                        const name = document.createElement("h4");
                        name.textContent = feedback.clientName;

                            const date = document.createElement("span");
                        date.textContent = feedback.createdAt;

                            const paragraph = document.createElement("p");
                       paragraph.style.whiteSpace = "pre-wrap";
                        paragraph.textContent = feedback.message;

                             header.appendChild(name);
                            header.appendChild(date);
                        item.appendChild(header);              item.appendChild(paragraph);

                                   feedbackList.prepend(item);

                            // Keep only the 20 most recent feedback items.
                        while (
                              feedbackList.querySelectorAll(".feedback-item").length > 20
                            ) {
                        feedbackList.lastElementChild.remove();
                        }

                        form.reset();
                            statusMessage.textContent = result.message;

                    } catch (error) {
                         statusMessage.textContent =
                            error.message || "An unexpected error occurred.";

                       console.error("Feedback submission error:", error);
                        }  finally {
                        submitButton.disabled = false;
                                submitButton.innerHTML = originalButtonText;
                        }
                 });
            });
    </script>
}