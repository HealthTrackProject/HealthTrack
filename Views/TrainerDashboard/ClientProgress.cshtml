@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Client Progress";
    ViewData["Heading"] = "Client Progress";
    ViewData["ActivePage"] = "ClientProgress";
}

<div class="ht-progress">

    <div class="ht-progress-header">
        <div>
            <h2>Client Progress</h2>
            <p>Monitor your clients' health and fitness journey.</p>
        </div>

        <div class="header-controls">
            <select id="clientSelector" class="select-client-dropdown">
                @if (ViewBag.Clients != null)
                {
                    foreach (var client in ViewBag.Clients)
                    {
                        <option value="@client.Value">@client.Text</option>
                    }
                }
            </select>

            <select id="progressPeriod" class="ht-period-select">
                <option value="3">Last 3 Months</option>
                <option value="6" selected>Last 6 Months</option>
                <option value="12">Last 12 Months</option>
            </select>
        </div>
    </div>

    <!-- STAT CARDS: Existing design retained -->
    <div class="ht-progress-cards">
        <div class="ht-stat-card weight-card">
            <div class="ht-stat-icon"><i class="bi bi-droplet-fill"></i></div>
            <div><span>Weight</span><strong id="currentWeight">—</strong></div>
        </div>

        <div class="ht-stat-card bmi-card">
            <div class="ht-stat-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div><span>BMI</span><strong id="currentBMI">—</strong></div>
        </div>

        <div class="ht-stat-card calories-card">
            <div class="ht-stat-icon"><i class="bi bi-fire"></i></div>
            <div><span>Calories Burned</span><strong id="currentCalories">—</strong></div>
        </div>

        <div class="ht-stat-card workouts-card">
            <div class="ht-stat-icon"><i class="bi bi-lightning-charge-fill"></i></div>
            <div><span>Workouts</span><strong id="currentWorkouts">—</strong></div>
        </div>
    </div>

    <!-- CHART SECTION -->
    <section class="ht-progress-panel">
        <div class="ht-progress-tabs" role="tablist">
            <button type="button" class="ht-progress-tab active" data-chart="weight">Weight</button>
            <button type="button" class="ht-progress-tab" data-chart="bmi">BMI</button>
            <button type="button" class="ht-progress-tab" data-chart="calories">Calories</button>
            <button type="button" class="ht-progress-tab" data-chart="workouts">Workouts</button>
        </div>

        <div class="ht-chart-container">
            <canvas id="healthProgressChart" aria-label="Health progress chart"></canvas>
        </div>

        <div class="ht-chart-summary">
            <span class="ht-chart-dot"></span>
            <span id="progressChartSummary">Weight progress over the last 6 months</span>
        </div>
    </section>

    <!-- PROGRESS OVERVIEW -->
    <section class="ht-progress-info">
        <div>
            <h3><i class="bi bi-graph-down-arrow"></i> Progress Overview</h3>
            <p>Client's progress summary for the selected period.</p>
        </div>

        <div class="ht-progress-info-value">
            <span>Change</span>
            <strong id="weightChange">—</strong>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (() => {
            const canvas = document.getElementById("healthProgressChart");
            const clientSelector = document.getElementById("clientSelector");
            const periodSelector = document.getElementById("progressPeriod");

            if (!canvas || typeof Chart === "undefined") {
                console.error("Chart.js could not be loaded.");
                return;
            }

            const endpoint = '@Url.Action("GetClientProgress", "TrainerDashboard")';
            const primaryColor = "#1E88E5";

            const chartInfo = {
                weight: {
                    label: "Weight (kg)",
                    summary: "Weight progress over the selected period"
                },
                bmi: {
                    label: "BMI",
                    summary: "BMI progress over the selected period"
                },
                calories: {
                    label: "Calories burned",
                    summary: "Calories burned over the selected period"
                },
                workouts: {
                    label: "Workouts",
                    summary: "Completed workouts over the selected period"
                }
            };

            let currentChart = "weight";
            let progressData = null;
            let requestId = 0;

            const chart = new Chart(canvas, {
                type: "line",
                data: {
                    labels: [],
                    datasets: [{
                        label: "Weight (kg)",
                        data: [],
                        borderColor: primaryColor,
                        backgroundColor: context => {
                            const area = context.chart.chartArea;

                            if (!area) {
                                return "rgba(30, 136, 229, 0.12)";
                            }

                            const gradient =
                                context.chart.ctx.createLinearGradient(
                                    0, area.top, 0, area.bottom
                                );

                            gradient.addColorStop(
                                0, "rgba(30, 136, 229, 0.30)"
                            );

                            gradient.addColorStop(
                                1, "rgba(30, 136, 229, 0.01)"
                            );

                            return gradient;
                        },
                        borderWidth: 2,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        pointBackgroundColor: primaryColor,
                        fill: true,
                        tension: 0.35,
                        spanGaps: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: "index"
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            border: {
                                display: false
                            },
                            ticks: {
                                color: "#718494",
                                font: {
                                    size: 11
                                }
                            }
                        },
                        y: {
                            border: {
                                display: false
                            },
                            grid: {
                                color: "#edf2f5"
                            },
                            ticks: {
                                color: "#718494",
                                font: {
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });

            function setSummary(message) {
                document.getElementById("progressChartSummary").textContent =
                    message;
            }

            function clearData(message) {
                progressData = null;

                chart.data.labels = [];
                chart.data.datasets[0].data = [];
                chart.update();

                document.getElementById("currentWeight").textContent = "—";
                document.getElementById("currentBMI").textContent = "—";
                document.getElementById("currentCalories").textContent = "—";
                document.getElementById("currentWorkouts").textContent = "—";
                document.getElementById("weightChange").textContent = "—";

                setSummary(message);
            }

            function updateChart() {
                if (!progressData) return;

                const selected = chartInfo[currentChart];

                chart.data.labels = progressData.labels || [];
                chart.data.datasets[0].label = selected.label;
                chart.data.datasets[0].data =
                    progressData.datasets[currentChart] || [];

                chart.update();

                setSummary(selected.summary);

                const change =
                    progressData.changes?.[currentChart] ?? "No data";

                document.getElementById("weightChange").textContent = change;

                const selectedOption =
                    clientSelector.options[clientSelector.selectedIndex];

                const clientName = selectedOption
                    ? selectedOption.text
                    : "selected client";

                document.querySelector(".ht-progress-info p").textContent =
                    `Progress summary for ${clientName}.`;
            }

            function updateStatistics(data) {
                document.getElementById("currentWeight").textContent =
                    data.currentWeight == null
                        ? "—"
                        : `${Number(data.currentWeight).toFixed(1)} kg`;

                document.getElementById("currentBMI").textContent =
                    data.currentBMI == null
                        ? "—"
                        : Number(data.currentBMI).toFixed(1);

                document.getElementById("currentCalories").textContent =
                    data.currentCalories == null
                        ? "—"
                        : Number(data.currentCalories).toLocaleString();

                document.getElementById("currentWorkouts").textContent =
                    data.currentWorkouts == null
                        ? "—"
                        : Number(data.currentWorkouts).toLocaleString();
            }

            async function loadProgress() {
                const clientId = clientSelector.value;
                const currentRequest = ++requestId;

                if (!clientId) {
                    clearData("No clients are available for progress tracking.");
                    return;
                }

                setSummary("Loading client progress...");

                try {
                    const url = new URL(endpoint, window.location.origin);

                    url.searchParams.set("clientId", clientId);
                    url.searchParams.set("months", periodSelector.value);

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        if (response.status === 403) {
                            throw new Error(
                                "You do not have access to this client's progress."
                            );
                        }

                        if (response.status === 401) {
                            throw new Error(
                                "Your session has expired. Please sign in again."
                            );
                        }

                        throw new Error(
                            "Unable to load client progress. Please try again."
                        );
                    }

                    const result = await response.json();

                    // Prevent an older request replacing newer selected data.
                    if (currentRequest !== requestId) return;

                    progressData = result;

                    updateStatistics(result);
                    updateChart();
                } catch (error) {
                    if (currentRequest !== requestId) return;

                    clearData(
                        error.message || "Error loading client progress."
                    );

                    console.error("Client progress error:", error);
                }
            }

            document.querySelectorAll(".ht-progress-tab")
                .forEach(button => {
                    button.addEventListener("click", () => {
                        currentChart = button.dataset.chart;

                        document.querySelectorAll(".ht-progress-tab")
                            .forEach(tab =>
                                tab.classList.remove("active")
                            );

                        button.classList.add("active");
                        updateChart();
                    });
                });

            clientSelector.addEventListener("change", loadProgress);
            periodSelector.addEventListener("change", loadProgress);

            loadProgress();
        })();
    </script>
}
